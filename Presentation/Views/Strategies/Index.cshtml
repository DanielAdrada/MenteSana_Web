@model List<Presentation.Models.StrategiesViewModel>

@{
    Layout = "~/Views/Shared/_PsychologistLayout.cshtml";
    ViewBag.Title = "Gestión de estrategias";
}

<div class="max-w-7xl mx-auto mt-10 px-5">

    <div class="bg-white rounded-3xl shadow-xl p-8">

        <!-- Encabezado -->
        <div class="flex justify-between items-center mb-8">

            <div>
                <h1 class="text-3xl font-bold text-gray-800">
                    Gestión de estrategias
                </h1>

                <p class="text-gray-600 mt-2">
                    Administra las estrategias disponibles para los estudiantes.
                </p>
            </div>

        </div>


        <!-- Mensaje de éxito -->
        @if (TempData["Mensaje"] != null)
        {
            <div class="bg-green-100 text-green-800 px-4 py-3 rounded-xl mb-6">
                @TempData["Mensaje"]
            </div>
        }


        <!-- Mensaje de error -->
        @if (TempData["Error"] != null)
        {
            <div class="bg-red-100 text-red-800 px-4 py-3 rounded-xl mb-6">
                @TempData["Error"]
            </div>
        }

        <!-- FORMULARIO DE ESTRATEGIA -->
        <div class="bg-gray-50 rounded-2xl p-6 mb-8">

            <h2 id="tituloFormulario"
                class="text-xl font-bold text-gray-800 mb-5">
                ➕ Nueva estrategia
            </h2>

            <form id="formEstrategia" action="@Url.Action("Crear", "Strategies")" method="post">

                <div class="grid md:grid-cols-3 gap-5">

                    <!-- Dimensión -->
                    <div>
                        <label for="dimension" class="block text-sm font-semibold mb-2">
                            Dimensión
                        </label>

                        <select id="dimension"
                                name="dimension"
                                class="w-full border rounded-xl px-4 py-3"
                                required
                                onchange="cargarAreas()">

                            <option value="">Seleccione una dimensión</option>
                            <option value="DEPRESION">Depresión</option>
                            <option value="ANSIEDAD">Ansiedad</option>
                            <option value="ESTRES">Estrés</option>

                        </select>
                    </div>

                    <!-- Área -->
                    <div>
                        <label for="area" class="block text-sm font-semibold mb-2">
                            Área
                        </label>

                        <select id="area"
                                name="area"
                                class="w-full border rounded-xl px-4 py-3"
                                required>

                            <option value="">Seleccione primero una dimensión</option>

                        </select>
                    </div>

                    <!-- Nivel -->
                    <div>
                        <label for="nivel" class="block text-sm font-semibold mb-2">
                            Nivel
                        </label>

                        <select id="nivel"
                                name="nivel"
                                class="w-full border rounded-xl px-4 py-3"
                                required>

                            <option value="">Seleccione un nivel</option>
                            <option value="Normal">Normal</option>
                            <option value="Leve">Leve</option>
                            <option value="Moderado">Moderado</option>
                            <option value="Severo">Severo</option>
                            <option value="Extremadamente Severo">
                                Extremadamente Severo
                            </option>

                        </select>
                    </div>

                </div>

                <!-- Título -->
                <div class="mt-5">

                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Título
                    </label>

                    <input type="text"
                           id="titulo"
                           name="titulo"
                           class="w-full border border-gray-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500"
                           placeholder="Título de la estrategia"
                           required />

                </div>

                <!-- Descripción -->
                <div class="mt-5">

                    <label class="block text-sm font-semibold text-gray-700 mb-2">
                        Descripción
                    </label>

                    <textarea id="descripcion"
                              name="descripcion"
                              rows="4"
                              class="w-full border border-gray-300 rounded-xl px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-500"
                              placeholder="Describe la estrategia que se aplicará al estudiante..."
                              required></textarea>

                </div>

                <!-- Botón -->
                <div class="mt-5 flex justify-end">

                    <button id="btnGuardar"
                            type="submit"
                            class="bg-blue-600 text-white px-6 py-3 rounded-xl font-semibold hover:bg-blue-700 transition">
                        Guardar estrategia
                    </button>

                </div>

            </form>

        </div>

        <!-- Tabla -->
        @if (Model != null && Model.Any())
        {
            <div class="overflow-x-auto">

                <table class="w-full border-collapse">

                    <thead>
                        <tr class="border-b text-left">

                            <th class="p-4">
                                Dimensión
                            </th>

                            <th class="p-4">
                                Área
                            </th>

                            <th class="p-4">
                                Nivel
                            </th>

                            <th class="p-4">
                                Título
                            </th>

                            <th class="p-4">
                                Estado
                            </th>

                            <th class="p-4 text-center">
                                Acciones
                            </th>

                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var estrategia in Model)
                        {
                            <tr class="border-b hover:bg-gray-50">

                                <td class="p-4">
                                    @estrategia.Dimension
                                </td>

                                <td class="p-4">
                                    @estrategia.Area
                                </td>

                                <td class="p-4">
                                    @estrategia.Nivel
                                </td>

                                <td class="p-4 font-semibold">
                                    @estrategia.Titulo
                                </td>

                                <td class="p-4">

                                    @if (estrategia.Activa)
                                    {
                                        <span class="bg-green-100 text-green-700 px-3 py-1 rounded-full text-sm">
                                            Activa
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="bg-gray-200 text-gray-700 px-3 py-1 rounded-full text-sm">
                                            Inactiva
                                        </span>
                                    }

                                </td>

                                <td class="p-4">

                                    <div class="flex justify-center gap-2">

                                        <!-- Editar -->
                                        <button type="button"
                                                onclick="editarEstrategia(
                                                    @estrategia.EstrategiaId,
                                                    '@Html.Raw(HttpUtility.JavaScriptStringEncode(estrategia.Dimension ?? ""))',
                                                    '@Html.Raw(HttpUtility.JavaScriptStringEncode(estrategia.Area ?? ""))',
                                                    '@Html.Raw(HttpUtility.JavaScriptStringEncode(estrategia.Nivel ?? ""))',
                                                    '@Html.Raw(HttpUtility.JavaScriptStringEncode(estrategia.Titulo ?? ""))',
                                                    '@Html.Raw(HttpUtility.JavaScriptStringEncode(estrategia.Descripcion ?? ""))'
                                                )"
                                                class="bg-yellow-500 text-white px-3 py-2 rounded-lg hover:bg-yellow-600">
                                            Editar
                                        </button>

                                        <!-- Activar / Desactivar -->
                                        <form action="@Url.Action(
                                            "CambiarEstado",
                                            "Strategies"
                                        )"
                                              method="post"
                                              style="display:inline;">

                                            <input type="hidden"
                                                   name="estrategiaId"
                                                   value="@estrategia.EstrategiaId" />

                                            <input type="hidden"
                                                   name="activa"
                                                   value="@(estrategia.Activa ? 0 : 1)" />

                                            @if (estrategia.Activa)
                                            {
                                                <button type="submit"
                                                        class="bg-red-500 text-white px-3 py-2 rounded-lg hover:bg-red-600">
                                                    Desactivar
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit"
                                                        class="bg-green-600 text-white px-3 py-2 rounded-lg hover:bg-green-700">
                                                    Activar
                                                </button>
                                            }

                                        </form>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="text-center py-12">

                <p class="text-gray-500 text-lg">
                    No hay estrategias registradas.
                </p>

            </div>
        }

    </div>

</div>

@section Scripts {
    <script src="~/Scripts/strategies.js"></script>
}
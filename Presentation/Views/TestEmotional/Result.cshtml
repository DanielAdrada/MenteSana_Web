@model Logic.Models.EmotionResult

@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewBag.Title = "Resultado DASS-42";
}

<section class="max-w-4xl mx-auto mt-10 px-5">

    <div class="bg-white rounded-3xl shadow-xl p-8">

        <div class="text-center mb-8">

            <div class="text-6xl mb-3">
                🧠
            </div>

            <h2 class="text-3xl font-bold">
                Resultado de tu evaluación
            </h2>

            <p class="text-gray-600 mt-2">
                Este resultado es orientativo y no reemplaza una evaluación profesional.
            </p>

        </div>

        <div class="grid md:grid-cols-3 gap-6">

            <!-- DEPRESIÓN -->
            <div class="border rounded-2xl p-6 text-center shadow-sm">

                <div class="text-5xl mb-3">
                    🌧️
                </div>

                <h3 class="font-bold text-xl">
                    Depresión
                </h3>

                <p class="text-2xl font-bold text-red-600 mt-3">
                    @Model.depresion
                </p>

            </div>

            <!-- ANSIEDAD -->
            <div class="border rounded-2xl p-6 text-center shadow-sm">

                <div class="text-5xl mb-3">
                    😰
                </div>

                <h3 class="font-bold text-xl">
                    Ansiedad
                </h3>

                <p class="text-2xl font-bold text-yellow-600 mt-3">
                    @Model.ansiedad
                </p>

            </div>

            <!-- ESTRÉS -->
            <div class="border rounded-2xl p-6 text-center shadow-sm">

                <div class="text-5xl mb-3">
                    ⚡
                </div>

                <h3 class="font-bold text-xl">
                    Estrés
                </h3>

                <p class="text-2xl font-bold text-blue-600 mt-3">
                    @Model.estres
                </p>

            </div>

        </div>

        <div class="text-center mt-10">

            <a href="@Url.Action("Survey","TestEmotional")"
               class="bg-secondary text-white px-8 py-3 rounded-xl font-semibold">

                🔄 Realizar nuevamente el test

            </a>

        </div>

    </div>

</section>
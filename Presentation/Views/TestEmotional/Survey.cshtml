@model Presentation.Models.TestDassViewModel

@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewBag.Title = "Test emocional";

}

<section class="max-w-6xl mx-auto px-6 py-8">
    <div class="relative overflow-hidden rounded-3xl shadow-2xl border border-white/20 bg-gradient-to-r from-emerald-400 via-cyan-500 to-blue-600 p-10 mb-8">

        <!-- Estrellitas -->
        <div class="absolute inset-0 pointer-events-none">
            <div class="absolute top-10 right-[48%] text-white/40 text-xl">✦</div>
            <div class="absolute top-20 right-[27%] text-white/50 text-2xl">✦</div>
            <div class="absolute top-32 right-[28%] text-white/40 text-sm">✦</div>
            <div class="absolute top-44 right-[18%] text-white/60 text-3xl">✦</div>
            <div class="absolute bottom-24 right-[30%] text-white/40 text-xl">✦</div>
            <div class="absolute bottom-16 right-20 text-white/50 text-2xl">✦</div>
            <div class="absolute top-56 right-[40%] text-white/30 text-lg">✦</div>
            <div class="absolute top-16 right-60 text-white/60 text-sm">✦</div>
        </div>

        <div class="grid md:grid-cols-2 gap-8 items-center">

            <div>
                <h1 class="mt-4 text-3xl md:text-5xl font-extrabold text-white drop-shadow-lg whitespace-nowrap">
                    Test de Bienestar Emocional 🧠
                </h1>
            </div>

        </div>

    </div>

    <div class="w-full mt-6 mb-6">

        <div class="bg-blue-50 border border-blue-200 rounded-2xl p-6 shadow-sm">

            <div class="flex items-center mb-4">
                <span class="text-2xl mr-2">ℹ️</span>
                <h2 class="text-xl font-bold text-blue-800">
                    ¿Cómo responder?
                </h2>
            </div>

            <p class="text-gray-700 mb-5">
                Lee cada afirmación y selecciona el número que mejor describa
                cómo te has sentido durante la última semana.
                No existen respuestas correctas o incorrectas. 💙
            </p>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">

                <div class="bg-white rounded-xl border p-4 text-center shadow-sm">
                    <div class="text-3xl font-bold text-blue-600">0</div>
                    <p class="font-semibold mt-2">Nunca</p>
                    <small class="text-gray-500">
                        No se aplicó a mí en absoluto.
                    </small>
                </div>

                <div class="bg-white rounded-xl border p-4 text-center shadow-sm">
                    <div class="text-3xl font-bold text-blue-600">1</div>
                    <p class="font-semibold mt-2">Algunas veces</p>
                    <small class="text-gray-500">
                        Aplicado a mí en cierto grado, o parte del tiempo.
                    </small>
                </div>

                <div class="bg-white rounded-xl border p-4 text-center shadow-sm">
                    <div class="text-3xl font-bold text-blue-600">2</div>
                    <p class="font-semibold mt-2">Frecuentemente</p>
                    <small class="text-gray-500">
                        Se aplicó a mí en gran medida, o una buena parte del tiempo.
                    </small>
                </div>

                <div class="bg-white rounded-xl border p-4 text-center shadow-sm">
                    <div class="text-3xl font-bold text-blue-600">3</div>
                    <p class="font-semibold mt-2">Casi siempre</p>
                    <small class="text-gray-500">
                        Me aplico mucho, o la mayor parte del tiempo.
                    </small>
                </div>

            </div>

        </div>

    </div>

    <div class="w-full mt-8">

        <div class="flex justify-between items-center mb-2">
            <span class="font-semibold text-gray-700">
                Bloque @Model.Bloque de 3
            </span>

            <span class="text-sm text-gray-600">
                @Model.Progreso%
            </span>
        </div>

        <div class="w-full bg-gray-200 rounded-full h-3">
            <div class="bg-secondary h-3 rounded-full"
                 style="width:@Model.Progreso%">
            </div>
        </div>

    </div>

    <main class="w-full my-8">

        <form method="post"
              action="@Url.Action("Analizar", "TestEmotional")"
              class="bg-card rounded-2xl shadow-soft p-6 space-y-10">

            <input type="hidden" name="bloque" value="@Model.Bloque" />

            @for (int i = 0; i < Model.Preguntas.Count; i++)
            {
                <div class="bg-white border border-gray-200 rounded-xl p-5 mb-5 shadow-sm">

                    <div class="flex items-start gap-4">

                        <div class="w-10 h-10 rounded-full bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold">

                            @(Model.InicioPregunta + i + 1)
                        </div>

                        <div class="flex-1">

                            <p class="text-base md:text-lg font-medium text-gray-700 leading-relaxed">

                                @Model.Preguntas[i]

                            </p>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mt-5">

                        <label class="cursor-pointer">

                            <input class="peer absolute opacity-0"
                                   type="radio"
                                   name="p@(Model.InicioPregunta+i+1)"
                                   value="0"
                                   required>

                            <div class="rounded-xl border border-gray-200 bg-gray-50 p-3 text-center transition hover:border-indigo-300 hover:bg-indigo-50 peer-checked:bg-blue-50 peer-checked:text-blue-800 peer-checked:border-blue-300">
                                <div class="text-sm font-semibold">
                                    0
                                </div>

                                <div class="text-sm mt-1">
                                    Nunca
                                </div>
                            </div>

                        </label>

                        <label class="cursor-pointer">

                            <input class="peer absolute opacity-0"
                                   type="radio"
                                   name="p@(Model.InicioPregunta+i+1)"
                                   value="1">

                            <div class="rounded-xl border border-gray-200 bg-gray-50 p-3 text-center transition hover:border-indigo-300 hover:bg-indigo-50 peer-checked:bg-blue-50 peer-checked:text-blue-800 peer-checked:border-blue-300">
                                <div class="text-sm font-semibold">
                                    1
                                </div>

                                <div class="text-sm mt-1">
                                    Algunas veces
                                </div>
                            </div>

                        </label>

                        <label class="cursor-pointer">

                            <input class="peer absolute opacity-0"
                                   type="radio"
                                   name="p@(Model.InicioPregunta+i+1)"
                                   value="2">

                            <div class="rounded-xl border border-gray-200 bg-gray-50 p-3 text-center transition hover:border-indigo-300 hover:bg-indigo-50 peer-checked:bg-blue-50 peer-checked:text-blue-800 peer-checked:border-blue-300">
                                <div class="text-sm font-semibold">
                                    2
                                </div>

                                <div class="text-sm mt-1">
                                    Frecuentemente
                                </div>
                            </div>

                        </label>

                        <label class="cursor-pointer">

                            <input class="peer absolute opacity-0"
                                   type="radio"
                                   name="p@(Model.InicioPregunta+i+1)"
                                   value="3">

                            <div class="rounded-xl border border-gray-200 bg-gray-50 p-3 text-center transition hover:border-indigo-300 hover:bg-indigo-50 peer-checked:bg-blue-50 peer-checked:text-blue-800 peer-checked:border-blue-300">
                                <div class="text-sm font-semibold">
                                    3
                                </div>

                                <div class="text-sm mt-1">
                                    Siempre
                                </div>
                            </div>

                        </label>
                    </div>
                </div>
             }

            @if (Model.UltimoBloque)
            {
                <button type="submit"
                        class="bg-secondary text-white px-7 py-3 rounded-xl font-semibold shadow-lg">
                    Finalizar Test 💙
                </button>
            }
            else
            {
                <button type="submit"
                        class="bg-secondary text-white px-7 py-3 rounded-xl font-semibold shadow-lg">
                    Siguiente →
                </button>
            }
        </form>
    </main>
</section>

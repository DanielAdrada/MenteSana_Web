@model Presentation.Models.ResourcesViewModel
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewBag.Title = "Recursos educativos";
}

<section class="max-w-7xl mx-auto px-6 py-10">

    <!-- Banner -->
    <div class="relative overflow-hidden rounded-3xl shadow-2xl border border-white/20 bg-gradient-to-r from-emerald-400 via-cyan-500 to-blue-600 p-10 mb-8">

        <!-- Estrellitas -->
        <div class="absolute inset-0 pointer-events-none">
            <div class="absolute top-10 right-[48%] text-white/40 text-xl">✦</div>
            <div class="absolute top-20 right-[35%] text-white/50 text-2xl">✦</div>
            <div class="absolute top-32 right-[28%] text-white/40 text-sm">✦</div>
            <div class="absolute top-44 right-[18%] text-white/60 text-3xl">✦</div>
            <div class="absolute bottom-24 right-[30%] text-white/40 text-xl">✦</div>
            <div class="absolute bottom-16 right-20 text-white/50 text-2xl">✦</div>
            <div class="absolute top-56 right-[40%] text-white/30 text-lg">✦</div>
            <div class="absolute top-16 right-60 text-white/60 text-sm">✦</div>
        </div>

        <div class="grid md:grid-cols-2 gap-8 items-center">

            <div>

                <h1 class="mt-4 text-3xl md:text-5xl font-extrabold text-white drop-shadow-lg whitespace-nowrap">
                    Recursos Educativos 💙
                </h1>

                <p class="mt-1 text-lg md:text-1xl text-white">
                    Explora los recursos publicados por nuestros psicólogos para fortalecer tu bienestar emocional,
                    aprender nuevas estrategias y desarrollar hábitos saludables.
                </p>

            </div>

        </div>

    </div>


    <!-- Barra superior -->
    <div class="bg-white rounded-2xl shadow-sm p-5 mb-8">
        <div class="flex flex-col lg:flex-row gap-5 justify-between items-center">
            <div class="flex flex-wrap gap-3">
                <button class="filtro-btn active" onclick="filtrarRecursos('Todos', this)">
                    📚 Todos
                </button>

                <button class="filtro-btn" onclick="filtrarRecursos('Video', this)">
                    🎬 Videos
                </button>

                <button class="filtro-btn" onclick="filtrarRecursos('Documento', this)">
                    📄 Documentos
                </button>

                <button class="filtro-btn" onclick="filtrarRecursos('Imagen', this)">
                    🖼 Imágenes
                </button>

                <button class="filtro-btn" onclick="filtrarRecursos('URL', this)">
                    🔗 Enlaces
                </button>
            </div>

            <input type="text"
                   id="buscarRecurso"
                   placeholder="🔍 Buscar recurso..."
                   onkeyup="buscarRecursos()"
                   class="w-80 rounded-xl border px-4 py-3" />
        </div>
    </div>


    <!-- Tarjetas -->
    <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-6">
        @foreach (var item in Model.ListaRecursos)
        {
            <div class="recurso-card bg-white rounded-3xl shadow-sm hover:shadow-xl transition duration-300 p-6 flex flex-col justify-between"
                 data-tipo="@item.Tipo"
                 data-titulo="@item.Titulo"
                 data-descripcion="@item.Descripcion">
                <div>
                    <div class="flex justify-between items-center mb-4">
                        <div class="w-14 h-14 rounded-2xl bg-slate-100 flex items-center justify-center text-3xl">
                            @if (item.Tipo == "Video")
                            {<i class="bi bi-play-circle-fill text-red-500"></i>}
                            else if (item.Tipo == "Documento")
                            {<i class="bi bi-file-earmark-text-fill text-blue-600"></i>}
                            else if (item.Tipo == "Imagen")
                            {<i class="bi bi-image-fill text-emerald-500"></i>}
                            else if (item.Tipo == "URL")
                            {<i class="bi bi-link-45deg text-cyan-500"></i>}
                        </div>

                        @{
                            string colorTipo = "bg-slate-100 text-slate-600";

                            if (item.Tipo == "Video")
                            {
                                colorTipo = "bg-transparent border border-red-500 text-red-600";
                            }
                            else if (item.Tipo == "Documento")
                            {
                                colorTipo = "bg-transparent border border-blue-500 text-blue-600";
                            }
                            else if (item.Tipo == "Imagen")
                            {
                                colorTipo = "bg-transparent border border-emerald-500 text-emerald-600";
                            }
                            else if (item.Tipo == "URL")
                            {
                                colorTipo = "bg-transparent border border-cyan-500 text-cyan-600";
                            }
                        }

                    <span class="@colorTipo text-sm px-4 py-2 rounded-full fw-semibold">
                        @item.Tipo
                    </span>

                    </div>

                    <h3 class="font-bold text-xl text-slate-800 mb-3">@item.Titulo</h3>
                    <p class="text-slate-500 text-sm mb-5">@item.Descripcion</p>
                </div>

                <div class="space-y-3">
                    @if (!string.IsNullOrEmpty(item.Archivo))
                    {
                        <a href="@Url.Content("~/Uploads/" + item.Archivo)"
                           target="_blank"
                           class="block w-full text-center bg-blue-500 hover:bg-blue-600 text-white py-2.5 rounded-xl font-medium transition">

                            <i class="bi bi-download me-2"></i>
                            Abrir archivo

                        </a>
                    }
                    @if (!string.IsNullOrEmpty(item.Url))
                    {
                        <a href="@item.Url"
                           target="_blank"
                           class="block w-full text-center border border-sky-400 text-sky-600 hover:bg-sky-50 py-2.5 rounded-xl font-medium transition">

                            <i class="bi bi-box-arrow-up-right me-2"></i>
                            Visitar enlace

                        </a>
                    }
                </div>
            </div>
        }

    </div>

    <div id="sinResultados" class="hidden text-center py-10">

        <div class="text-6xl mb-4">
            🔍
        </div>

        <h3 class="text-2xl font-bold text-gray-700">
            No se encontraron recursos
        </h3>

        <p class="text-gray-500 mt-2">
            Intenta escribir otra palabra.
        </p>

    </div>

</section>

<link href="~/Content/resources.css" rel="stylesheet" />
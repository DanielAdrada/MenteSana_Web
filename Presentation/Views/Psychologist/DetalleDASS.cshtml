@model Presentation.Models.DassDetailViewModel

@{
    Layout = "~/Views/Shared/_PsychologistLayout.cshtml";
    ViewBag.Title = "Detalle DASS-42";
}

<section class="max-w-7xl mx-auto px-6 py-10">

    <!-- Encabezado -->
    <div class="mb-8">

        <div class="flex items-center gap-3 mb-4">

            <a href="@Url.Action("HistorialDASS", "Psychologist", new { id = Model.Test.EstudianteId })"
               class="w-10 h-10 rounded-xl bg-gray-100 dark:bg-slate-700 flex items-center justify-center text-gray-600 dark:text-gray-200 hover:bg-gray-200 dark:hover:bg-slate-600 transition-colors">
                ←
            </a>

            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary to-secondary text-white flex items-center justify-center text-2xl">
                📊
            </div>

            <div>
                <h1 class="text-3xl font-bold text-deep dark:text-white">
                    Detalle DASS-42
                </h1>

                <p class="text-muted dark:text-gray-400">
                    Consulta el resultado detallado de la evaluación.
                </p>
            </div>

        </div>


        <!-- Información del estudiante -->
        <div class="bg-card dark:bg-slate-800 rounded-2xl shadow-md p-6">

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

                <div>
                    <p class="text-sm text-muted dark:text-gray-400 mb-1">
                        Estudiante
                    </p>

                    <p class="text-lg font-bold text-deep dark:text-white">
                        @Model.Test.Estudiante
                    </p>
                </div>


                <div>
                    <p class="text-sm text-muted dark:text-gray-400 mb-1">
                        Grado / Curso
                    </p>

                    <p class="text-lg font-bold text-deep dark:text-white">
                        @Model.Test.GradoCurso
                    </p>
                </div>


                <div>
                    <p class="text-sm text-muted dark:text-gray-400 mb-1">
                        Fecha de evaluación
                    </p>

                    <p class="text-lg font-bold text-deep dark:text-white">
                        @Model.Test.Fecha.ToString("dd/MM/yyyy HH:mm")
                    </p>
                </div>

            </div>

        </div>

    </div>


    <!-- Resultados -->
    <div class="mb-8">

        <h2 class="text-2xl font-bold text-deep dark:text-white mb-5">
            Resultados de la evaluación
        </h2>


        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

            <!-- Depresión -->
            <div class="bg-card dark:bg-slate-800 rounded-2xl shadow-md p-6">

                <div class="flex items-center justify-between mb-4">

                    <h3 class="text-lg font-semibold text-deep dark:text-white">
                        Depresión
                    </h3>

                    <span class="text-2xl">
                        💙
                    </span>

                </div>

                <span class="inline-block px-4 py-2 rounded-xl bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300 font-semibold">
                    @Model.Test.NivelDepresion
                </span>

            </div>


            <!-- Ansiedad -->
            <div class="bg-card dark:bg-slate-800 rounded-2xl shadow-md p-6">

                <div class="flex items-center justify-between mb-4">

                    <h3 class="text-lg font-semibold text-deep dark:text-white">
                        Ansiedad
                    </h3>

                    <span class="text-2xl">
                        🌿
                    </span>

                </div>

                <span class="inline-block px-4 py-2 rounded-xl bg-yellow-100 text-yellow-700 dark:bg-yellow-900/40 dark:text-yellow-300 font-semibold">
                    @Model.Test.NivelAnsiedad
                </span>

            </div>


            <!-- Estrés -->
            <div class="bg-card dark:bg-slate-800 rounded-2xl shadow-md p-6">

                <div class="flex items-center justify-between mb-4">

                    <h3 class="text-lg font-semibold text-deep dark:text-white">
                        Estrés
                    </h3>

                    <span class="text-2xl">
                        🧠
                    </span>

                </div>

                <span class="inline-block px-4 py-2 rounded-xl bg-purple-100 text-purple-700 dark:bg-purple-900/40 dark:text-purple-300 font-semibold">
                    @Model.Test.NivelEstres
                </span>

            </div>

        </div>

    </div>


    <!-- Respuestas -->
    <div class="bg-card dark:bg-slate-800 rounded-2xl shadow-lg overflow-hidden">

        <div class="px-6 py-5 border-b border-gray-200 dark:border-slate-700">

            <h2 class="text-xl font-semibold text-deep dark:text-white">
                Respuestas del DASS-42
            </h2>

            <p class="text-sm text-muted dark:text-gray-400 mt-1">
                Respuestas registradas durante la evaluación.
            </p>

        </div>


        @if (Model.Respuestas != null && Model.Respuestas.Any())
        {
            <div class="p-6">

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

                    @foreach (var respuesta in Model.Respuestas)
                    {
                        string textoRespuesta = "";

                        switch (respuesta.Valor)
                        {
                            case 0:
                                textoRespuesta = "Nunca";
                                break;

                            case 1:
                                textoRespuesta = "A veces";
                                break;

                            case 2:
                                textoRespuesta = "Muchas veces";
                                break;

                            case 3:
                                textoRespuesta = "Siempre";
                                break;

                            default:
                                textoRespuesta = "Valor no válido";
                                break;
                        }

                        <div class="border border-gray-200 dark:border-slate-700 rounded-xl p-4 flex items-center justify-between">

                            <div>
                                <p class="font-semibold text-deep dark:text-white">
                                    Pregunta @respuesta.Pregunta
                                </p>

                                <p class="text-sm text-muted dark:text-gray-400">
                                    Valor registrado: @respuesta.Valor
                                </p>
                            </div>

                            <span class="px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-700 dark:bg-slate-700 dark:text-gray-200">
                                @textoRespuesta
                            </span>

                        </div>
                    }

                </div>

            </div>
        }
        else
        {
            <div class="px-6 py-16 text-center">

                <div class="text-5xl mb-4">
                    📋
                </div>

                <h3 class="text-xl font-semibold text-deep dark:text-white mb-2">
                    No hay respuestas registradas
                </h3>

                <p class="text-muted dark:text-gray-400">
                    No se encontraron respuestas para esta evaluación.
                </p>

            </div>
        }

    </div>


    <!-- Botón volver -->
    <div class="mt-8">

        <a href="@Url.Action("HistorialDASS", "Psychologist", new { id = Model.Test.EstudianteId })"
           class="inline-flex items-center gap-2 bg-secondary hover:bg-blue-600 text-white px-5 py-2.5 rounded-xl font-semibold transition-colors">

            ← Volver al historial

        </a>

    </div>

</section>
@model List<Data.Models.DassTestDTO>

@{
    Layout = "~/Views/Shared/_PsychologistLayout.cshtml";
    ViewBag.Title = "Resultados DASS-42";
}

<!-- HERO -->
<section class="max-w-7xl mx-auto px-5 mt-6 mb-8">

    <div class="relative overflow-hidden rounded-3xl shadow-2xl border border-white/20 bg-gradient-to-r from-emerald-400 via-cyan-500 to-blue-600">

        <div class="absolute inset-0 pointer-events-none">
            <div class="absolute top-10 right-[48%] text-white/40 text-xl">✦</div>
            <div class="absolute top-20 right-[35%] text-white/50 text-2xl">✦</div>
            <div class="absolute top-32 right-[28%] text-white/40 text-sm">✦</div>
            <div class="absolute top-44 right-[18%] text-white/60 text-3xl">✦</div>
            <div class="absolute bottom-24 right-[30%] text-white/40 text-xl">✦</div>
            <div class="absolute bottom-16 right-20 text-white/50 text-2xl">✦</div>
            <div class="absolute top-56 right-[40%] text-white/30 text-lg">✦</div>
            <div class="absolute top-16 right-60 text-white/60 text-sm">✦</div>
        </div>

        <div class="grid md:grid-cols-2 items-center min-h-[270px]">

            <div class="px-8 md:px-12 py-10 z-10">

                <h1 class="mt-4 text-3xl md:text-5xl font-extrabold text-white drop-shadow-lg whitespace-nowrap">
                    📊 Resultados DASS - 42
                </h1>

                <p class="mt-3 text-lg md:text-2xl text-white/95 max-w-xl leading-relaxed">
                    Consulta los resultados más recientes de los estudiantes evaluados
                </p>

            </div>
        </div>
    </div>

    <div class="mt-5">
        <!-- Tabla de resultados -->
        <div class="bg-card dark:bg-slate-800 rounded-2xl shadow-lg overflow-hidden">

            <div class="px-6 py-5 border-b border-gray-200 dark:border-slate-700">
                <h2 class="text-xl font-semibold text-deep dark:text-white">
                    Últimos resultados por estudiante
                </h2>

                <p class="text-sm text-muted dark:text-gray-400 mt-1">
                    Se muestra únicamente la evaluación más reciente de cada estudiante.
                </p>
            </div>

            @if (Model != null && Model.Any())
            {
                <div class="overflow-x-auto">

                    <table class="w-full text-sm text-left">

                        <thead class="bg-gray-50 dark:bg-slate-700">
                            <tr>
                                <th class="px-6 py-4 font-semibold text-gray-700 dark:text-gray-200">
                                    Estudiante
                                </th>

                                <th class="px-6 py-4 font-semibold text-gray-700 dark:text-gray-200">
                                    Grado / Curso
                                </th>

                                <th class="px-6 py-4 font-semibold text-gray-700 dark:text-gray-200">
                                    Depresión
                                </th>

                                <th class="px-6 py-4 font-semibold text-gray-700 dark:text-gray-200">
                                    Ansiedad
                                </th>

                                <th class="px-6 py-4 font-semibold text-gray-700 dark:text-gray-200">
                                    Estrés
                                </th>

                                <th class="px-6 py-4 font-semibold text-gray-700 dark:text-gray-200">
                                    Fecha
                                </th>

                                <th class="px-6 py-4 font-semibold text-gray-700 dark:text-gray-200 text-center">
                                    Acción
                                </th>
                            </tr>
                        </thead>

                        <tbody class="divide-y divide-gray-200 dark:divide-slate-700">

                            @foreach (var resultado in Model)
                            {
                                <tr class="hover:bg-gray-50 dark:hover:bg-slate-700/50 transition-colors">

                                    <!-- Estudiante -->
                                    <td class="px-6 py-4">
                                        <div class="font-semibold text-deep dark:text-white">
                                            @resultado.Estudiante
                                        </div>
                                    </td>

                                    <!-- Grado / Curso -->
                                    <td class="px-6 py-4 text-gray-600 dark:text-gray-300">
                                        @resultado.GradoCurso
                                    </td>

                                    <!-- Depresión -->
                                    <td class="px-6 py-4">
                                        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-blue-100 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300">
                                            @resultado.NivelDepresion
                                        </span>
                                    </td>

                                    <!-- Ansiedad -->
                                    <td class="px-6 py-4">
                                        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-yellow-100 text-yellow-700 dark:bg-yellow-900/40 dark:text-yellow-300">
                                            @resultado.NivelAnsiedad
                                        </span>
                                    </td>

                                    <!-- Estrés -->
                                    <td class="px-6 py-4">
                                        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-purple-100 text-purple-700 dark:bg-purple-900/40 dark:text-purple-300">
                                            @resultado.NivelEstres
                                        </span>
                                    </td>

                                    <!-- Fecha -->
                                    <td class="px-6 py-4 text-gray-600 dark:text-gray-300 whitespace-nowrap">
                                        @resultado.Fecha.ToString("dd/MM/yyyy HH:mm")
                                    </td>

                                    <!-- Acción -->
                                    <td class="px-6 py-4 text-center">

                                        <a href="@Url.Action("HistorialDASS", "Psychologist", new { id = resultado.EstudianteId })"
                                           class="inline-flex items-center gap-2 bg-secondary hover:bg-blue-600 text-white px-4 py-2 rounded-xl font-semibold transition-colors">

                                            <span>📋</span>
                                            <span>Ver historial</span>

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <!-- Sin resultados -->
                <div class="px-6 py-16 text-center">

                    <div class="text-5xl mb-4">
                        📋
                    </div>

                    <h3 class="text-xl font-semibold text-deep dark:text-white mb-2">
                        No hay resultados disponibles
                    </h3>

                    <p class="text-muted dark:text-gray-400">
                        Todavía no se han registrado evaluaciones DASS-42.
                    </p>

                </div>
            }

        </div>
   </div>

</section>
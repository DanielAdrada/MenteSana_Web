@model Presentation.Models.DashboardViewModel
@using System.Linq

@{
    Layout = "~/Views/Shared/_PsychologistLayout.cshtml";
    ViewBag.Title = "Panel del Psicólogo";

    var estadisticas = Model.EstadisticasDASS ?? new List<Data.Models.DassDashboardStatisticDTO>();

    var depresion = estadisticas
        .Where(x => x.Dimension == "Depresión")
        .ToList();

    var ansiedad = estadisticas
        .Where(x => x.Dimension == "Ansiedad")
        .ToList();

    var estres = estadisticas
        .Where(x => x.Dimension == "Estrés")
        .ToList();

    var totalDepresion = depresion.Sum(x => x.Cantidad);
    var totalAnsiedad = ansiedad.Sum(x => x.Cantidad);
    var totalEstres = estres.Sum(x => x.Cantidad);
}

<!-- HEADER -->
<section class="max-w-7xl mx-auto px-5 mt-6 mb-8">

    <div class="relative overflow-hidden rounded-3xl shadow-2xl border border-white/20
                bg-gradient-to-r from-emerald-400 via-cyan-500 to-blue-600">

        <!-- Decoraciones -->
        <div class="absolute top-0 left-0 w-40 h-40 bg-white/10 rounded-full -translate-x-16 -translate-y-16"></div>
        <div class="absolute bottom-0 right-1/3 w-60 h-60 bg-white/5 rounded-full translate-y-24"></div>

        <!-- Estrellitas -->
        <div class="absolute inset-0 pointer-events-none">
            <div class="absolute top-10 right-[48%] text-white/40 text-xl">✦</div>
            <div class="absolute top-20 right-[35%] text-white/50 text-2xl">✦</div>
            <div class="absolute top-32 right-[28%] text-white/40 text-sm">✦</div>
            <div class="absolute top-44 right-[18%] text-white/60 text-3xl">✦</div>
            <div class="absolute bottom-24 right-[30%] text-white/40 text-xl">✦</div>
            <div class="absolute bottom-16 right-20 text-white/50 text-2xl">✦</div>
            <div class="absolute top-56 right-[40%] text-white/30 text-lg">✦</div>
            <div class="absolute top-16 right-60 text-white/60 text-sm">✦</div>
        </div>

        <div class="grid md:grid-cols-2 items-center min-h-[270px]">

            <div class="px-8 md:px-12 py-10 z-10">

                <span class="inline-flex items-center gap-2 bg-white/35 backdrop-blur-sm text-green-700 border border-green-200 px-4 py-1.5 rounded-full text-xs md:text-sm font-medium">
                    🧠 Panel profesional
                </span>

                <h1 class="mt-4 text-3xl md:text-5xl font-extrabold text-white drop-shadow-lg whitespace-nowrap">
                    Panel del Psicólogo
                </h1>

                <p class="text-white/90 mt-3 max-w-[600px]">
                    Visualiza patrones emocionales, gestiona recursos
                    y acompaña a los estudiantes desde un enfoque preventivo.
                </p>

            </div>
        </div>
    </div>


    <!-- MAIN -->
    <main class="max-w-7xl mx-auto px-5 mt-8 mb-12 space-y-8">

        <!-- MÉTRICAS DEL SISTEMA -->
        <section class="grid sm:grid-cols-2 xl:grid-cols-4 gap-6">

            <!-- ESTUDIANTES EVALUADOS -->
            <div class="group relative overflow-hidden bg-card rounded-2xl shadow-soft
                border border-slate-100 dark:border-slate-700
                p-6 transition-all duration-300
                hover:-translate-y-2 hover:shadow-2xl">

                <div class="absolute -right-8 -top-8 w-24 h-24
                    bg-emerald-400/10 rounded-full
                    transition-transform duration-500
                    group-hover:scale-150">
                </div>

                <div class="relative z-10">

                    <div class="flex items-center justify-between">

                        <div class="w-12 h-12 rounded-xl
                            bg-emerald-100 dark:bg-emerald-900/30
                            flex items-center justify-center
                            text-2xl
                            transition-transform duration-300
                            group-hover:scale-110 group-hover:rotate-3">
                            👥
                        </div>

                        <span class="text-xs font-medium
                             text-emerald-600 dark:text-emerald-400
                             bg-emerald-50 dark:bg-emerald-900/20
                             px-3 py-1 rounded-full">
                            DASS-42
                        </span>

                    </div>

                    <p class="mt-5 text-sm font-medium text-muted">
                        Estudiantes evaluados
                    </p>

                    <h3 class="mt-1 text-3xl font-extrabold text-secondary
                       dark:text-white">
                        @Model.EstudiantesEvaluados
                    </h3>

                    <p class="mt-2 text-xs text-muted">
                        Estudiantes con al menos una evaluación
                    </p>

                </div>
            </div>


            <!-- EVALUACIONES REALIZADAS -->
            <div class="group relative overflow-hidden bg-card rounded-2xl shadow-soft
                border border-slate-100 dark:border-slate-700
                p-6 transition-all duration-300
                hover:-translate-y-2 hover:shadow-2xl">

                <div class="absolute -right-8 -top-8 w-24 h-24
                    bg-cyan-400/10 rounded-full
                    transition-transform duration-500
                    group-hover:scale-150">
                </div>

                <div class="relative z-10">

                    <div class="flex items-center justify-between">

                        <div class="w-12 h-12 rounded-xl
                            bg-cyan-100 dark:bg-cyan-900/30
                            flex items-center justify-center
                            text-2xl
                            transition-transform duration-300
                            group-hover:scale-110 group-hover:rotate-3">
                            📝
                        </div>

                        <span class="text-xs font-medium
                             text-cyan-600 dark:text-cyan-400
                             bg-cyan-50 dark:bg-cyan-900/20
                             px-3 py-1 rounded-full">
                            Total
                        </span>

                    </div>

                    <p class="mt-5 text-sm font-medium text-muted">
                        Evaluaciones realizadas
                    </p>

                    <h3 class="mt-1 text-3xl font-extrabold text-secondary
                       dark:text-white">
                        @Model.EvaluacionesRealizadas
                    </h3>

                    <p class="mt-2 text-xs text-muted">
                        Tests DASS-42 registrados
                    </p>

                </div>
            </div>


            <!-- SEGUIMIENTO -->
            <div class="group relative overflow-hidden bg-card rounded-2xl shadow-soft
                border border-slate-100 dark:border-slate-700
                p-6 transition-all duration-300
                hover:-translate-y-2 hover:shadow-2xl">

                <div class="absolute -right-8 -top-8 w-24 h-24
                    bg-amber-400/10 rounded-full
                    transition-transform duration-500
                    group-hover:scale-150">
                </div>

                <div class="relative z-10">

                    <div class="flex items-center justify-between">

                        <div class="w-12 h-12 rounded-xl
                            bg-amber-100 dark:bg-amber-900/30
                            flex items-center justify-center
                            text-2xl
                            transition-transform duration-300
                            group-hover:scale-110 group-hover:rotate-3">
                            ⚠️
                        </div>

                        <span class="text-xs font-medium
                             text-amber-600 dark:text-amber-400
                             bg-amber-50 dark:bg-amber-900/20
                             px-3 py-1 rounded-full">
                            Atención
                        </span>

                    </div>

                    <p class="mt-5 text-sm font-medium text-muted">
                        Requieren seguimiento
                    </p>

                    <h3 class="mt-1 text-3xl font-extrabold text-secondary
                       dark:text-white">
                        @Model.RequierenSeguimiento
                    </h3>

                    <p class="mt-2 text-xs text-muted">
                        Con algún nivel desde moderado
                    </p>

                </div>
            </div>


            <!-- ÚLTIMA EVALUACIÓN -->
            <div class="group relative overflow-hidden bg-card rounded-2xl shadow-soft
                border border-slate-100 dark:border-slate-700
                p-6 transition-all duration-300
                hover:-translate-y-2 hover:shadow-2xl">

                <div class="absolute -right-8 -top-8 w-24 h-24
                    bg-blue-400/10 rounded-full
                    transition-transform duration-500
                    group-hover:scale-150">
                </div>

                <div class="relative z-10">

                    <div class="flex items-center justify-between">

                        <div class="w-12 h-12 rounded-xl
                            bg-blue-100 dark:bg-blue-900/30
                            flex items-center justify-center
                            text-2xl
                            transition-transform duration-300
                            group-hover:scale-110 group-hover:rotate-3">
                            📅
                        </div>

                        <span class="text-xs font-medium
                             text-blue-600 dark:text-blue-400
                             bg-blue-50 dark:bg-blue-900/20
                             px-3 py-1 rounded-full">
                            Reciente
                        </span>

                    </div>

                    <p class="mt-5 text-sm font-medium text-muted">
                        Última evaluación
                    </p>

                    <h3 class="mt-1 text-2xl font-extrabold text-secondary
                       dark:text-white">

                        @if (Model.UltimaEvaluacion.HasValue)
                        {
                            @Model.UltimaEvaluacion.Value.ToString("dd/MM/yyyy")
                        }
                        else
                        {
                            <span>Sin datos</span>
                        }

                    </h3>

                    <p class="mt-2 text-xs text-muted">
                        Fecha del último DASS-42
                    </p>

                </div>
            </div>

        </section>

        <!-- GESTIÓN DE ESTRATEGIAS -->
        <section class="relative overflow-hidden bg-card rounded-2xl shadow-soft
                border border-emerald-100 dark:border-slate-700 p-6">

            <!-- Decoración -->
            <div class="absolute -right-10 -top-10 w-32 h-32
                bg-emerald-400/10 rounded-full">
            </div>

            <div class="absolute -right-4 -bottom-12 w-24 h-24
                bg-cyan-400/10 rounded-full">
            </div>


            <div class="relative z-10 flex flex-col sm:flex-row
                items-center justify-between gap-4">


                <!-- INFORMACIÓN -->
                <div class="flex items-center gap-4">

                    <!-- ICONO -->
                    <div class="w-14 h-14 rounded-2xl
                        bg-gradient-to-br from-emerald-400 to-cyan-500
                        flex items-center justify-center
                        text-2xl shadow-md flex-shrink-0">

                        🧠

                    </div>


                    <!-- TEXTO -->
                    <div>

                        <h3 class="text-lg font-bold text-secondary dark:text-white">
                            Gestión de estrategias
                        </h3>

                        <p class="text-sm text-muted dark:text-gray-400 mt-1">
                            Administra las estrategias disponibles para los estudiantes.
                        </p>

                    </div>

                </div>


                <!-- BOTÓN -->
                <a href="@Url.Action("Index", "Strategies")"
                   class="group inline-flex items-center gap-2
                  bg-gradient-to-r from-emerald-400 to-cyan-500
                  hover:from-emerald-500 hover:to-cyan-600
                  text-white
                  px-5 py-2.5
                  rounded-xl
                  font-semibold
                  shadow-md
                  hover:shadow-lg
                  transition-all duration-300
                  whitespace-nowrap">

                    <span>Gestionar estrategias</span>

                    <span class="transition-transform duration-300
                         group-hover:translate-x-1">
                        →
                    </span>

                </a>

            </div>

        </section>


        <!-- NOTIFICACIONES DASS -->
        <section class="bg-card rounded-2xl shadow-soft border border-slate-100 dark:border-slate-700 p-6">

            <!-- ENCABEZADO -->
            <div class="flex items-center justify-between mb-5">

                <div>

                    <div class="flex items-center gap-2">

                        <div class="w-10 h-10 rounded-xl
                            bg-emerald-100
                            flex items-center justify-center
                            text-lg">
                            🔔
                        </div>

                        <h2 class="text-xl font-bold text-secondary dark:text-white">
                            Notificaciones
                        </h2>

                    </div>

                    <p class="text-sm text-muted mt-2 ml-12">
                        Evaluaciones que requieren revisión profesional
                    </p>

                </div>

                <!-- CONTADOR -->
                <span class="bg-red-100 text-red-700
                     px-3 py-1.5
                     rounded-full
                     text-sm font-semibold">
                    @Model.NotificacionesPendientes
                </span>

            </div>

            @if (Model.Notificaciones != null && Model.Notificaciones.Any())
            {
                <!-- CARRUSEL DE NOTIFICACIONES -->
                <div class="relative">

                    <!-- FLECHA IZQUIERDA -->
                    <button type="button"
                            onclick="moverNotificaciones(-1)"
                            class="absolute left-2 top-1/2 -translate-y-1/2 z-20
                   w-10 h-10 rounded-full
                   bg-white border border-emerald-100
                   shadow-md
                   flex items-center justify-center
                   text-emerald-600 text-xl
                   hover:bg-emerald-50
                   transition">
                        ‹
                    </button>


                    <!-- CONTENEDOR HORIZONTAL -->
                    <div id="carruselNotificaciones"
                         class="flex gap-4 overflow-x-auto scroll-smooth
                px-14 py-2"
                         style="scrollbar-width: none;">

                        @foreach (var notificacion in Model.Notificaciones)
                        {
                            <!-- TARJETA -->
                            <div class="flex-none
                        w-[calc(50%-8px)]
                        bg-white dark:bg-slate-800
                        border border-emerald-100
                        dark:border-slate-700
                        rounded-2xl
                        shadow-sm
                        p-4
                        hover:shadow-md
                        transition">

                                <div class="flex items-start gap-3">

                                    <!-- ICONO -->
                                    <div class="w-10 h-10 rounded-xl
                                bg-emerald-50
                                flex items-center justify-center
                                text-lg flex-shrink-0">
                                        ⚠️
                                    </div>


                                    <div class="flex-1 min-w-0">

                                        <!-- TÍTULO Y FECHA -->
                                        <div class="flex justify-between items-start gap-2">

                                            <h3 class="font-bold text-gray-800
                                       dark:text-white text-sm">
                                                Nueva evaluación DASS-42
                                            </h3>

                                            <span class="text-[11px]
                                         text-gray-400
                                         whitespace-nowrap">
                                                @notificacion.Fecha.ToString("dd/MM/yyyy HH:mm")
                                            </span>

                                        </div>


                                        <!-- MENSAJE -->
                                        <p class="text-sm text-gray-600
                                  dark:text-gray-300 mt-1">
                                            @notificacion.Mensaje
                                        </p>


                                        <!-- ESTUDIANTE -->
                                        <p class="text-xs text-gray-500 mt-2">
                                            <strong>Estudiante:</strong>
                                            @notificacion.EstudianteId
                                        </p>


                                        <!-- BOTONES -->
                                        <div class="mt-3 flex gap-2">

                                            <a href="@Url.Action(
                                "DetalleDASS",
                                "Psychologist",
                                new { id = notificacion.TestId })"
                                               class="inline-flex items-center gap-1
                                      bg-emerald-500
                                      hover:bg-emerald-600
                                      text-white
                                      text-xs font-semibold
                                      px-3 py-2
                                      rounded-lg transition">

                                                👁️ Ver resultado

                                            </a>


                                            <form method="post"
                                                  action="@Url.Action(
                                      "MarcarNotificacionAtendida",
                                      "Psychologist")">

                                                <input type="hidden"
                                                       name="id"
                                                       value="@notificacion.Id" />

                                                <button type="submit"
                                                        class="inline-flex items-center gap-1
                                               bg-gray-100
                                               hover:bg-gray-200
                                               text-gray-700
                                               text-xs font-semibold
                                               px-3 py-2
                                               rounded-lg transition">

                                                    ✓ Atendida

                                                </button>

                                            </form>

                                        </div>

                                    </div>

                                </div>

                            </div>
                        }

                    </div>


                    <!-- FLECHA DERECHA -->
                    <button type="button"
                            onclick="moverNotificaciones(1)"
                            class="absolute right-2 top-1/2 -translate-y-1/2 z-20
                   w-10 h-10 rounded-full
                   bg-white border border-emerald-100
                   shadow-md
                   flex items-center justify-center
                   text-emerald-600 text-xl
                   hover:bg-emerald-50
                   transition">
                        ›
                    </button>

                </div>

                <!-- VER TODAS -->
                if (Model.NotificacionesPendientes > 5)
                {
                    <div class="text-center mt-5">

                        <a href="#"
                           class="inline-flex items-center
                          text-emerald-600
                          hover:text-emerald-700
                          font-semibold">

                            Ver todas las notificaciones →

                        </a>

                    </div>
                }

            }
            else
            {
                <!-- SIN NOTIFICACIONES -->
                <div class="bg-white rounded-2xl border border-gray-100
                    shadow-sm p-8 text-center">

                    <div class="text-4xl mb-3">
                        🔔
                    </div>

                    <h3 class="font-semibold text-gray-700">
                        No hay notificaciones pendientes
                    </h3>

                    <p class="text-sm text-gray-500 mt-1">
                        Las nuevas alertas DASS-42 aparecerán aquí.
                    </p>

                </div>
            }

        </section>

            <!-- ESTADÍSTICAS DASS-42 -->
            <section class="bg-card rounded-xl2 shadow-soft p-6">

                <div class="mb-6">
                    <h3 class="text-secondary font-semibold text-lg">
                        📊 Distribución de resultados DASS-42
                    </h3>

                    <p class="text-sm text-muted mt-1">
                        Distribución de los niveles registrados en las evaluaciones realizadas.
                    </p>
                </div>


                <div class="grid lg:grid-cols-3 gap-8">

                    <!-- DEPRESIÓN -->
                    <div>

                        <div class="flex items-center justify-between mb-4">
                            <h4 class="font-semibold text-secondary">
                                Depresión
                            </h4>

                            <span class="text-xs text-muted">
                                @totalDepresion evaluaciones
                            </span>
                        </div>

                        @if (depresion.Any())
                        {
                            <div class="space-y-4">

                                @foreach (var item in depresion)
                                {
                                    var porcentaje = totalDepresion > 0
                                        ? (item.Cantidad * 100 / totalDepresion)
                                        : 0;

                                    <div>
                                        <div class="flex justify-between items-center mb-1">
                                            <span class="text-sm text-gray-700 dark:text-gray-300">
                                                @item.Nivel
                                            </span>

                                            <span class="text-sm font-semibold text-secondary">
                                                @item.Cantidad
                                            </span>
                                        </div>

                                        <div class="h-3 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
                                            <div class="h-3 bg-primary rounded-full transition-all duration-500"
                                                 style="width: @porcentaje%;">
                                            </div>
                                        </div>
                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <p class="text-sm text-muted">
                                No hay datos de depresión.
                            </p>
                        }

                    </div>


                    <!-- ANSIEDAD -->
                    <div>

                        <div class="flex items-center justify-between mb-4">
                            <h4 class="font-semibold text-secondary">
                                Ansiedad
                            </h4>

                            <span class="text-xs text-muted">
                                @totalAnsiedad evaluaciones
                            </span>
                        </div>

                        @if (ansiedad.Any())
                        {
                            <div class="space-y-4">

                                @foreach (var item in ansiedad)
                                {
                                    var porcentaje = totalAnsiedad > 0
                                        ? (item.Cantidad * 100 / totalAnsiedad)
                                        : 0;

                                    <div>
                                        <div class="flex justify-between items-center mb-1">
                                            <span class="text-sm text-gray-700 dark:text-gray-300">
                                                @item.Nivel
                                            </span>

                                            <span class="text-sm font-semibold text-secondary">
                                                @item.Cantidad
                                            </span>
                                        </div>

                                        <div class="h-3 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
                                            <div class="h-3 bg-secondary rounded-full transition-all duration-500"
                                                 style="width: @porcentaje%;">
                                            </div>
                                        </div>
                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <p class="text-sm text-muted">
                                No hay datos de ansiedad.
                            </p>
                        }

                    </div>


                    <!-- ESTRÉS -->
                    <div>

                        <div class="flex items-center justify-between mb-4">
                            <h4 class="font-semibold text-secondary">
                                Estrés
                            </h4>

                            <span class="text-xs text-muted">
                                @totalEstres evaluaciones
                            </span>
                        </div>

                        @if (estres.Any())
                        {
                            <div class="space-y-4">

                                @foreach (var item in estres)
                                {
                                    var porcentaje = totalEstres > 0
                                        ? (item.Cantidad * 100 / totalEstres)
                                        : 0;

                                    <div>
                                        <div class="flex justify-between items-center mb-1">
                                            <span class="text-sm text-gray-700 dark:text-gray-300">
                                                @item.Nivel
                                            </span>

                                            <span class="text-sm font-semibold text-secondary">
                                                @item.Cantidad
                                            </span>
                                        </div>

                                        <div class="h-3 bg-gray-200 dark:bg-gray-700 rounded-full overflow-hidden">
                                            <div class="h-3 bg-amber-400 rounded-full transition-all duration-500"
                                                 style="width: @porcentaje%;">
                                            </div>
                                        </div>
                                    </div>
                                }

                            </div>
                        }
                        else
                        {
                            <p class="text-sm text-muted">
                                No hay datos de estrés.
                            </p>
                        }

                    </div>

                </div>

            </section>

    </main>

    <script>
        function moverNotificaciones(direccion) {

            const carrusel =
                document.getElementById("carruselNotificaciones");

            const desplazamiento =
                carrusel.clientWidth * 0.85;

            carrusel.scrollBy({
                left: direccion * desplazamiento,
                behavior: "smooth"
            });
        }
    </script>

</section>
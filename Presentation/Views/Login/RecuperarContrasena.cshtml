@{
    Layout = "~/Views/Shared/_LoginLayout.cshtml";
    ViewBag.Title = "Recuperar contraseña";
}

<div class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50 to-emerald-50 flex items-center justify-center px-5 py-12">

    ```
    <div class="w-full max-w-5xl">

        <!-- CONTENEDOR PRINCIPAL -->
        <div class="relative overflow-hidden rounded-3xl shadow-2xl border border-white/30 bg-white">

            <!-- DECORACIONES -->
            <div class="absolute top-0 left-0 w-48 h-48 bg-emerald-400/10 rounded-full -translate-x-24 -translate-y-24"></div>

            <div class="absolute bottom-0 right-0 w-72 h-72 bg-blue-500/10 rounded-full translate-x-32 translate-y-32"></div>

            <div class="absolute top-20 right-24 text-blue-300/40 text-2xl">
                ✦
            </div>

            <div class="absolute bottom-28 left-16 text-emerald-300/40 text-xl">
                ✦
            </div>

            <!-- HEADER -->
            <div class="relative bg-gradient-to-r from-emerald-400 via-cyan-500 to-blue-600 px-8 md:px-12 py-10 overflow-hidden">

                <!-- Decoraciones del hero -->
                <div class="absolute top-0 right-0 w-40 h-40 bg-white/10 rounded-full translate-x-16 -translate-y-16"></div>

                <div class="absolute bottom-0 left-1/3 w-32 h-32 bg-white/10 rounded-full translate-y-20"></div>

                <div class="relative z-10">

                    <!-- ETIQUETA -->
                    <span class="inline-flex items-center gap-2 bg-white/25 backdrop-blur-sm text-white border border-white/30 px-4 py-1.5 rounded-full text-xs md:text-sm font-medium">

                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="w-5 h-5"
                             fill="none"
                             viewBox="0 0 24 24"
                             stroke="currentColor">

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M12 11c1.657 0 3-1.343 3-3S13.657 5 12 5 9 6.343 9 8s1.343 3 3 3z" />

                            <path stroke-linecap="round"
                                  stroke-linejoin="round"
                                  stroke-width="2"
                                  d="M5.5 20a6.5 6.5 0 0113 0" />

                        </svg>

                        Seguridad de tu cuenta

                    </span>

                    <!-- TITULO -->
                    <h1 class="mt-4 text-3xl md:text-5xl font-extrabold text-white drop-shadow-lg">
                        Recuperar contraseña 🔐
                    </h1>

                    <p class="mt-3 text-lg md:text-xl text-white/95 max-w-2xl leading-relaxed">
                        Crea una nueva contraseña para volver a acceder a tu cuenta de Mente Sana.
                    </p>

                </div>

            </div>


            <!-- CONTENIDO -->
            <div class="relative grid md:grid-cols-5 gap-0">

                <!-- INFORMACIÓN -->
                <div class="md:col-span-2 bg-slate-50 p-8 md:p-10 border-b md:border-b-0 md:border-r border-gray-200">

                    <div class="w-16 h-16 rounded-2xl bg-blue-100 flex items-center justify-center mb-6">

                        <span class="text-3xl">
                            🔐
                        </span>

                    </div>

                    <h2 class="text-2xl font-bold text-slate-800">
                        Protege tu cuenta
                    </h2>

                    <p class="mt-3 text-gray-600 leading-relaxed">
                        Elige una contraseña nueva y segura para continuar utilizando Mente Sana.
                    </p>


                    <!-- REQUISITOS -->
                    <div class="mt-8 space-y-4">

                        <div class="flex items-start gap-3">

                            <div class="w-8 h-8 rounded-full bg-emerald-100 flex items-center justify-center shrink-0">
                                <span class="text-emerald-600">✓</span>
                            </div>

                            <div>
                                <p class="font-semibold text-slate-700">
                                    Mínimo 8 caracteres
                                </p>

                                <p class="text-sm text-gray-500">
                                    Utiliza una contraseña suficientemente larga.
                                </p>
                            </div>

                        </div>


                        <div class="flex items-start gap-3">

                            <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center shrink-0">
                                <span class="text-blue-600">✓</span>
                            </div>

                            <div>
                                <p class="font-semibold text-slate-700">
                                    Confirma tu contraseña
                                </p>

                                <p class="text-sm text-gray-500">
                                    Ambas contraseñas deben coincidir.
                                </p>
                            </div>

                        </div>


                        <div class="flex items-start gap-3">

                            <div class="w-8 h-8 rounded-full bg-cyan-100 flex items-center justify-center shrink-0">
                                <span class="text-cyan-600">✓</span>
                            </div>

                            <div>
                                <p class="font-semibold text-slate-700">
                                    Enlace temporal
                                </p>

                                <p class="text-sm text-gray-500">
                                    El enlace de recuperación tiene un tiempo limitado.
                                </p>
                            </div>

                        </div>

                    </div>

                </div>


                <!-- FORMULARIO -->
                <div class="md:col-span-3 p-8 md:p-10">

                    @if (ViewBag.Error != null)
                    {
                        <div class="mb-6 p-4 rounded-2xl bg-red-50 border border-red-200 text-red-700 flex items-start gap-3">

                            <span class="text-xl">
                                ⚠️
                            </span>

                            <p class="leading-relaxed">
                                @ViewBag.Error
                            </p>

                        </div>
                    }


                    @if (ViewBag.Success != null)
                    {
                        <div class="mb-6 p-4 rounded-2xl bg-emerald-50 border border-emerald-200 text-emerald-700 flex items-start gap-3">

                            <span class="text-xl">
                                ✅
                            </span>

                            <p class="leading-relaxed">
                                @ViewBag.Success
                            </p>

                        </div>

                        <div class="text-center mt-8">

                            <a href="@Url.Action("Index", "Login")"
                               class="inline-flex items-center justify-center gap-2 px-8 py-3 rounded-xl bg-gradient-to-r from-emerald-500 to-blue-600 text-white font-semibold shadow-md hover:shadow-lg hover:scale-[1.02] transition">

                                ← Volver al inicio de sesión

                            </a>

                        </div>
                    }
                    else if (ViewBag.Token != null)
                    {
                        <div class="mb-7">

                            <h2 class="text-2xl font-bold text-slate-800">
                                Nueva contraseña
                            </h2>

                            <p class="mt-2 text-gray-500">
                                Completa los campos para actualizar tu contraseña.
                            </p>

                        </div>


                        using (Html.BeginForm(
                            "RecuperarContrasena",
                            "Login",
                            FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="token"
                                   value="@ViewBag.Token" />


                            <!-- NUEVA CONTRASEÑA -->
                            <div class="mb-6">

                                <label class="block text-sm font-semibold text-slate-700 mb-2">
                                    Nueva contraseña
                                </label>

                                <div class="relative">

                                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
                                        🔒
                                    </span>

                                    <input type="password"
                                           id="nuevaContrasena"
                                           name="nuevaContrasena"
                                           minlength="8"
                                           required
                                           autocomplete="new-password"
                                           placeholder="Mínimo 8 caracteres"
                                           class="w-full pl-12 pr-12 py-3.5 border border-gray-200 rounded-xl bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" />

                                    <button type="button"
                                            id="toggleNuevaContrasena"
                                            class="absolute inset-y-0 right-0 flex items-center px-4
               text-gray-500 hover:text-blue-600 transition"
                                            aria-label="Mostrar contraseña"
                                            title="Mostrar contraseña">

                                        <i id="iconoNuevaContrasena" class="bi bi-eye text-lg">👁</i>

                                    </button>

                                </div>

                            </div>


                            <!-- CONFIRMAR CONTRASEÑA -->
                            <div class="mb-7">

                                <label class="block text-sm font-semibold text-slate-700 mb-2">
                                    Confirmar contraseña
                                </label>

                                <div class="relative">

                                    <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">
                                        🔐
                                    </span>

                                    <input type="password"
                                           id="confirmarContrasena"
                                           name="confirmarContrasena"
                                           minlength="8"
                                           required
                                           autocomplete="new-password"
                                           placeholder="Repite tu contraseña"
                                           class="w-full pl-12 pr-12 py-3.5 border border-gray-200 rounded-xl bg-gray-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition" />

                                    <button type="button"
                                            id="toggleConfirmarContrasena"
                                            class="absolute inset-y-0 right-0 flex items-center px-4
               text-gray-500 hover:text-blue-600 transition"
                                            aria-label="Mostrar contraseña"
                                            title="Mostrar contraseña">

                                        <i id="iconoConfirmarContrasena" class="bi bi-eye text-lg">👁</i>

                                    </button>

                                </div>

                                <p id="mensajeContrasena"
                                   class="hidden mt-2 text-sm text-red-600">
                                </p>

                            </div>


                            <!-- BOTÓN -->
                            <button type="submit"
                                    id="btnCambiarContrasena"
                                    class="w-full py-3.5 rounded-xl bg-gradient-to-r from-emerald-500 to-blue-600 text-white font-semibold shadow-md hover:shadow-lg hover:scale-[1.01] transition">

                                Cambiar contraseña 🔐

                            </button>

                        }

                    }
                    else
                    {
                        <div class="text-center py-8">

                            <div class="w-16 h-16 mx-auto rounded-full bg-red-100 flex items-center justify-center">
                                <span class="text-3xl">
                                    ⚠️
                                </span>
                            </div>

                            <h2 class="mt-5 text-2xl font-bold text-slate-800">
                                Enlace no válido
                            </h2>

                            <p class="mt-2 text-gray-500">
                                El enlace de recuperación no es válido o ya no está disponible.
                            </p>

                            <a href="@Url.Action("Index", "Login")"
                               class="inline-flex mt-6 px-7 py-3 rounded-xl bg-blue-600 text-white font-semibold hover:bg-blue-700 transition">

                                Volver al inicio de sesión

                            </a>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- PIE -->
        <div class="text-center mt-6">

            <p class="text-sm text-gray-500">
                💙 Mente Sana · Tu bienestar también importa
            </p>

        </div>

    </div>
    ```

</div>

<!-- VALIDACIÓN VISUAL -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const nueva = document.getElementById("nuevaContrasena");
        const confirmar = document.getElementById("confirmarContrasena");
        const mensaje = document.getElementById("mensajeContrasena");

        if (!nueva || !confirmar || !mensaje)
            return;

        function validarContrasenas() {

            if (confirmar.value.length === 0) {
                mensaje.classList.add("hidden");
                return;
            }

            if (nueva.value !== confirmar.value) {

                mensaje.textContent = "Las contraseñas no coinciden.";
                mensaje.classList.remove("hidden");

            }
            else {

                mensaje.textContent = "";
                mensaje.classList.add("hidden");

            }

        }

        nueva.addEventListener("input", validarContrasenas);
        confirmar.addEventListener("input", validarContrasenas);

    });

</script>

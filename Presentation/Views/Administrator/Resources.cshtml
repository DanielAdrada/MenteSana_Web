@model Presentation.Models.ResourcesViewModel

@{
    ViewBag.Title = "Recursos educativos";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="max-w-7xl mx-auto px-5 mt-6 mb-8">

    <!-- Encabezado -->
    <div class="relative overflow-hidden rounded-3xl shadow-2xl border border-white/20
                bg-gradient-to-r from-emerald-400 via-cyan-500 to-blue-600 mb-10">

        <div class="absolute top-0 left-0 w-40 h-40 bg-white/10 rounded-full
                    -translate-x-16 -translate-y-16"></div>

        <div class="absolute bottom-0 right-1/3 w-60 h-60 bg-white/5 rounded-full
                    translate-y-24"></div>

        <div class="px-8 md:px-12 py-10">

            <span class="inline-flex items-center gap-2 bg-white/35 backdrop-blur-sm
                         text-green-700 border border-green-200 px-4 py-1.5 rounded-full
                         text-sm font-medium">

                <i class="bi bi-book"></i>
                Panel Administrativo

            </span>

            <h1 class="mt-4 text-3xl md:text-5xl font-extrabold text-white">
                Recursos Educativos 📚
            </h1>

            <p class="mt-3 text-lg text-white/95 max-w-3xl">
                Consulta los recursos educativos publicados por los psicólogos
                y verifica quién realizó cada publicación.
            </p>

        </div>

    </div>


    <!-- Contenedor principal -->
    <div class="bg-white border border-gray-200 rounded-3xl shadow-md p-8">

        <div class="flex flex-col md:flex-row md:items-center
                    md:justify-between gap-4 mb-8">

            <div>

                <h2 class="text-2xl font-bold text-gray-800">
                    Recursos publicados
                </h2>

                <p class="text-gray-500 mt-1">
                    Listado de recursos disponibles para los estudiantes.
                </p>

            </div>

            <div class="bg-cyan-50 text-cyan-700 px-5 py-3 rounded-xl font-semibold">

                <i class="bi bi-collection-play me-2"></i>

                @(Model.ListaRecursos != null
                    ? Model.ListaRecursos.Count
                    : 0)
                recursos

            </div>

        </div>


        @if (Model.ListaRecursos != null && Model.ListaRecursos.Count > 0)
        {
            <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-6">

                @foreach (var recurso in Model.ListaRecursos)
                {
                    <div class="border border-gray-200 rounded-2xl p-6
                                hover:shadow-lg transition duration-300">

                        <!-- Tipo -->
                        <div class="flex justify-between items-center mb-5">

                            <div class="w-12 h-12 rounded-xl bg-slate-100
                                        flex items-center justify-center text-2xl">

                                @if (recurso.Tipo == "Video")
                                {
                                    <i class="bi bi-play-circle-fill text-red-500"></i>
                                }
                                else if (recurso.Tipo == "Documento")
                                {
                                    <i class="bi bi-file-earmark-text-fill text-blue-600"></i>
                                }
                                else if (recurso.Tipo == "Imagen")
                                {
                                    <i class="bi bi-image-fill text-emerald-500"></i>
                                }
                                else if (recurso.Tipo == "URL")
                                {
                                    <i class="bi bi-link-45deg text-cyan-500"></i>
                                }
                                else
                                {
                                    <i class="bi bi-file-earmark text-gray-500"></i>
                                }

                            </div>

                            <span class="px-3 py-1 rounded-full
                                         bg-gray-100 text-gray-600
                                         text-sm font-semibold">

                                @recurso.Tipo

                            </span>

                        </div>


                        <!-- Información del recurso -->
                        <h3 class="text-xl font-bold text-gray-800 mb-3">

                            @recurso.Titulo

                        </h3>

                        <p class="text-sm text-gray-500 mb-5">

                            @recurso.Descripcion

                        </p>


                        <!-- Psicólogo -->
                        <div class="border-t border-gray-100 pt-4 mb-5">

                            <p class="text-xs uppercase tracking-wide
                                      text-gray-400 font-semibold mb-1">

                                Publicado por

                            </p>

                            @if (!string.IsNullOrWhiteSpace(recurso.NombrePsicologo))
                            {
                                <p class="font-semibold text-gray-700">

                                    <i class="bi bi-person-badge text-cyan-500 me-1"></i>

                                    @recurso.NombrePsicologo
                                    @recurso.ApellidoPsicologo

                                </p>

                                <p class="text-xs text-gray-400 mt-1">

                                    ID: @recurso.IdPsicologo

                                </p>
                            }
                            else
                            {
                                <p class="text-gray-400 italic">

                                    Psicólogo no identificado

                                </p>
                            }

                        </div>


                        <!-- Fecha -->
                        <div class="flex items-center gap-2
                                    text-sm text-gray-400 mb-5">

                            <i class="bi bi-calendar3"></i>

                            @recurso.Fecha.ToString("dd/MM/yyyy HH:mm")

                        </div>


                        <!-- Acciones -->
                        <div class="space-y-2">

                            @if (!string.IsNullOrEmpty(recurso.Archivo))
                            {
                                <a href="@Url.Content("~/Uploads/" + recurso.Archivo)"
                                   target="_blank"
                                   class="block w-full text-center
                                          bg-blue-500 hover:bg-blue-600
                                          text-white py-2.5 rounded-xl
                                          font-medium transition">

                                    <i class="bi bi-file-earmark-arrow-down me-2"></i>

                                    Abrir archivo

                                </a>
                            }

                            @if (!string.IsNullOrEmpty(recurso.Url))
                            {
                                <a href="@recurso.Url"
                                   target="_blank"
                                   class="block w-full text-center
                                          border border-cyan-400
                                          text-cyan-600 hover:bg-cyan-50
                                          py-2.5 rounded-xl
                                          font-medium transition">

                                    <i class="bi bi-box-arrow-up-right me-2"></i>

                                    Visitar enlace

                                </a>
                            }

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <!-- Sin recursos -->
            <div class="text-center py-16">

                <div class="text-6xl mb-4">
                    📚
                </div>

                <h3 class="text-2xl font-bold text-gray-700">
                    No hay recursos publicados
                </h3>

                <p class="text-gray-500 mt-2">
                    Cuando un psicólogo publique un recurso,
                    aparecerá aquí.
                </p>

            </div>
        }

    </div>

</section>
@model Presentation.Models.AdminDashboardViewModel

@{
    ViewBag.Title = "Inicio";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="max-w-7xl mx-auto px-5 mt-6 mb-10">

    <!-- HERO -->
    <div class="relative overflow-hidden rounded-3xl shadow-2xl border border-white/20
                bg-gradient-to-r from-cyan-500 via-sky-600 to-blue-700">

        <!-- Decoraciones -->
        <div class="absolute -top-16 -left-16 w-48 h-48 bg-white/10 rounded-full"></div>
        <div class="absolute bottom-0 right-0 w-72 h-72 bg-white/10 rounded-full translate-x-24 translate-y-24"></div>
        <div class="absolute top-10 right-1/3 w-16 h-16 bg-white/5 rounded-full"></div>

        <!-- Estrellas -->
        <div class="absolute inset-0 pointer-events-none">

            <div class="absolute top-8 left-1/3 text-white/40 text-xl">✦</div>
            <div class="absolute top-20 right-40 text-white/40 text-2xl">✦</div>
            <div class="absolute top-32 left-2/3 text-white/50 text-lg">✦</div>
            <div class="absolute bottom-14 right-24 text-white/40 text-xl">✦</div>
            <div class="absolute bottom-20 left-20 text-white/40 text-lg">✦</div>

        </div>

        <div class="relative z-10 px-10 py-12">

            <span class="inline-flex items-center gap-2 rounded-full
                         bg-white/20 backdrop-blur-md
                         px-5 py-2 text-sm font-semibold text-white">

                <i class="bi bi-shield-lock-fill"></i>
                Panel Administrativo

            </span>

            <h1 class="mt-5 text-4xl md:text-5xl font-extrabold text-white">

                Bienvenido,
                <span class="text-cyan-100">
                    @Session["Usuario"]
                </span>

            </h1>

            <p class="mt-5 max-w-3xl text-lg text-white/90 leading-relaxed">

                Administra estudiantes, psicólogos, recursos educativos y la comunidad
                desde un único lugar. Consulta la información más importante del sistema
                de forma rápida y organizada.

            </p>

        </div>

    </div>


    <!-- TARJETAS -->
    <div class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-4 gap-6 mt-8">

        <!-- Psicólogos -->
        <div class="group bg-white rounded-3xl shadow-sm hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 border border-cyan-100">

            <div class="p-7">

                <div class="flex justify-between items-center">

                    <div>

                        <p class="text-sm text-slate-500">
                            Psicólogos
                        </p>

                        <h2 class="text-5xl font-black text-slate-800 mt-3">
                            @Model.TotalPsicologos
                        </h2>

                    </div>

                    <div class="w-16 h-16 rounded-2xl bg-cyan-100 flex items-center justify-center
                                group-hover:scale-110 transition">

                        <i class="bi bi-person-heart text-3xl text-cyan-600"></i>

                    </div>

                </div>

            </div>

        </div>

        <!-- Estudiantes -->
        <div class="group bg-white rounded-3xl shadow-sm hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 border border-green-100">

            <div class="p-7">

                <div class="flex justify-between items-center">

                    <div>

                        <p class="text-sm text-slate-500">
                            Estudiantes
                        </p>

                        <h2 class="text-5xl font-black text-slate-800 mt-3">
                            @Model.TotalEstudiantes
                        </h2>

                    </div>

                    <div class="w-16 h-16 rounded-2xl bg-green-100 flex items-center justify-center
                                group-hover:scale-110 transition">

                        <i class="bi bi-mortarboard-fill text-3xl text-green-600"></i>

                    </div>

                </div>

            </div>

        </div>

        <!-- Recursos -->
        <div class="group bg-white rounded-3xl shadow-sm hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 border border-amber-100">

            <div class="p-7">

                <div class="flex justify-between items-center">

                    <div>

                        <p class="text-sm text-slate-500">
                            Recursos
                        </p>

                        <h2 class="text-5xl font-black text-slate-800 mt-3">
                            @Model.TotalRecursos
                        </h2>

                    </div>

                    <div class="w-16 h-16 rounded-2xl bg-amber-100 flex items-center justify-center
                                group-hover:scale-110 transition">

                        <i class="bi bi-book-half text-3xl text-amber-600"></i>

                    </div>

                </div>

            </div>

        </div>

        <!-- Comentarios -->
        <div class="group bg-white rounded-3xl shadow-sm hover:shadow-2xl transition-all duration-300 hover:-translate-y-2 border border-violet-100">

            <div class="p-7">

                <div class="flex justify-between items-center">

                    <div>

                        <p class="text-sm text-slate-500">
                            Comentarios
                        </p>

                        <h2 class="text-5xl font-black text-slate-800 mt-3">
                            @Model.TotalComentarios
                        </h2>

                    </div>

                    <div class="w-16 h-16 rounded-2xl bg-violet-100 flex items-center justify-center
                                group-hover:scale-110 transition">

                        <i class="bi bi-chat-dots-fill text-3xl text-violet-600"></i>

                    </div>

                </div>

            </div>

        </div>
    </div>
    <!-- PANEL INFERIOR -->
    <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 mt-10">

        <!-- ACCESOS RÁPIDOS -->
        <div class="xl:col-span-2 bg-white rounded-3xl shadow-sm border border-slate-100 p-8">

            <div class="flex items-center justify-between mb-8">

                <div>

                    <h2 class="text-2xl font-bold text-slate-800">
                        Accesos rápidos
                    </h2>

                    <p class="text-slate-500 mt-1">
                        Gestiona rápidamente los módulos principales.
                    </p>

                </div>

                <div class="w-12 h-12 rounded-2xl bg-cyan-100 flex items-center justify-center">

                    <i class="bi bi-lightning-charge-fill text-cyan-600 text-xl"></i>

                </div>

            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

                <!-- Psicólogos -->
                <a href="@Url.Action("Psychologists","Administrator")"
                   class="group rounded-2xl border border-cyan-100 bg-cyan-50 hover:bg-cyan-100 transition-all duration-300 p-6">

                    <div class="flex items-center gap-4">

                        <div class="w-14 h-14 rounded-2xl bg-white flex items-center justify-center shadow">

                            <i class="bi bi-person-heart text-2xl text-cyan-600 group-hover:scale-110 transition"></i>

                        </div>

                        <div>

                            <h3 class="font-bold text-slate-800">
                                Psicólogos
                            </h3>

                            <p class="text-sm text-slate-500">
                                Administrar psicólogos
                            </p>

                        </div>

                    </div>

                </a>

                <!-- Estudiantes -->
                <a href="@Url.Action("Students","Administrator")"
                   class="group rounded-2xl border border-green-100 bg-green-50 hover:bg-green-100 transition-all duration-300 p-6">

                    <div class="flex items-center gap-4">

                        <div class="w-14 h-14 rounded-2xl bg-white flex items-center justify-center shadow">

                            <i class="bi bi-mortarboard-fill text-2xl text-green-600 group-hover:scale-110 transition"></i>

                        </div>

                        <div>

                            <h3 class="font-bold text-slate-800">
                                Estudiantes
                            </h3>

                            <p class="text-sm text-slate-500">
                                Administrar estudiantes
                            </p>

                        </div>

                    </div>

                </a>

                <!-- Recursos -->
                <a href="@Url.Action("Resources","Administrator")"
                   class="group rounded-2xl border border-amber-100 bg-amber-50 hover:bg-amber-100 transition-all duration-300 p-6">

                    <div class="flex items-center gap-4">

                        <div class="w-14 h-14 rounded-2xl bg-white flex items-center justify-center shadow">

                            <i class="bi bi-book-half text-2xl text-amber-600 group-hover:scale-110 transition"></i>

                        </div>

                        <div>

                            <h3 class="font-bold text-slate-800">
                                Recursos
                            </h3>

                            <p class="text-sm text-slate-500">
                                Administrar recursos
                            </p>

                        </div>

                    </div>

                </a>

                <!-- Comunidad -->
                <a href="@Url.Action("Comments","Administrator")"
                   class="group rounded-2xl border border-violet-100 bg-violet-50 hover:bg-violet-100 transition-all duration-300 p-6">

                    <div class="flex items-center gap-4">

                        <div class="w-14 h-14 rounded-2xl bg-white flex items-center justify-center shadow">

                            <i class="bi bi-chat-dots-fill text-2xl text-violet-600 group-hover:scale-110 transition"></i>

                        </div>

                        <div>

                            <h3 class="font-bold text-slate-800">
                                Comentarios
                            </h3>

                            <p class="text-sm text-slate-500">
                                Moderar comunidad
                            </p>

                        </div>

                    </div>

                </a>

            </div>

        </div>


        <!-- ESTADO -->
        <div class="bg-gradient-to-br from-sky-600 to-cyan-500 rounded-3xl shadow-xl text-white p-8">

            <div class="flex items-center justify-between">

                <h2 class="text-2xl font-bold">

                    Estado del sistema

                </h2>

                <i class="bi bi-activity text-3xl"></i>

            </div>

            <div class="mt-8 space-y-6">

                <div class="flex justify-between items-center">

                    <span>Servidor</span>

                    <span class="flex items-center gap-2">

                        <span class="w-3 h-3 rounded-full bg-green-300"></span>

                        En línea

                    </span>

                </div>

                <div class="flex justify-between items-center">

                    <span>Base de datos</span>

                    <span class="flex items-center gap-2">

                        <span class="w-3 h-3 rounded-full bg-green-300"></span>

                        Conectada

                    </span>

                </div>

                <div class="flex justify-between items-center">

                    <span>Modelo IA</span>

                    <span class="flex items-center gap-2">

                        <span class="w-3 h-3 rounded-full bg-green-300"></span>

                        Activo

                    </span>

                </div>

                <div class="border-t border-white/20 pt-6">

                    <p class="text-white/80 text-sm">

                        Todos los módulos principales del sistema se encuentran disponibles.

                    </p>

                </div>

            </div>

        </div>

    </div>


    <!-- RESUMEN -->
    <div class="bg-white rounded-3xl shadow-sm border border-slate-100 mt-8 p-8">

        <div class="flex items-center justify-between">

            <div>

                <h2 class="text-2xl font-bold text-slate-800">

                    Resumen del sistema

                </h2>

                <p class="text-slate-500 mt-1">

                    Información general de la plataforma Mente Sana.

                </p>

            </div>

            <div class="hidden md:flex w-14 h-14 rounded-2xl bg-sky-100 items-center justify-center">

                <i class="bi bi-bar-chart-fill text-sky-600 text-2xl"></i>

            </div>

        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6 mt-8">

            <div class="text-center">

                <h3 class="text-4xl font-black text-cyan-600">
                    @Model.TotalPsicologos
                </h3>

                <p class="text-slate-500 mt-2">
                    Psicólogos
                </p>

            </div>

            <div class="text-center">

                <h3 class="text-4xl font-black text-green-600">
                    @Model.TotalEstudiantes
                </h3>

                <p class="text-slate-500 mt-2">
                    Estudiantes
                </p>

            </div>

            <div class="text-center">

                <h3 class="text-4xl font-black text-amber-500">
                    @Model.TotalRecursos
                </h3>

                <p class="text-slate-500 mt-2">
                    Recursos
                </p>

            </div>

            <div class="text-center">

                <h3 class="text-4xl font-black text-violet-600">
                    @Model.TotalComentarios
                </h3>

                <p class="text-slate-500 mt-2">
                    Comentarios
                </p>

            </div>

        </div>

    </div>

</section>

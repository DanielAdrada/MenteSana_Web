@model Presentation.Models.StudentViewModel

@{
    ViewBag.Title = "Gestión de Estudiantes";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="max-w-7xl mx-auto px-5 mt-6 mb-8">

    @if (TempData["Success"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-green-100 border border-green-300 text-green-800">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-red-100 border border-red-300 text-red-800">
            @TempData["Error"]
        </div>
    }

    <!-- Encabezado -->
    <div class="relative overflow-hidden rounded-3xl shadow-2xl border border-white/20
                bg-gradient-to-r from-blue-500 via-cyan-500 to-indigo-600">

        <div class="absolute top-0 left-0 w-40 h-40 bg-white/10 rounded-full -translate-x-16 -translate-y-16"></div>

        <div class="grid md:grid-cols-2 items-center min-h-[220px]">

            <div class="px-8 md:px-12 py-10 z-10">

                <span class="inline-flex items-center gap-2 bg-white/35 backdrop-blur-sm
                             text-blue-700 border border-blue-200 px-4 py-1.5 rounded-full
                             text-sm font-medium">

                    <i class="bi bi-people-fill"></i>
                    Panel Administrativo

                </span>

                <h1 class="mt-4 text-3xl md:text-5xl font-extrabold text-white">
                    Gestión de Estudiantes 👨‍🎓
                </h1>

                <p class="mt-3 text-lg text-white/95">
                    Consulta, actualiza y administra los estudiantes registrados en la plataforma.
                </p>

            </div>

        </div>

    </div>

    <!-- Formulario de edición -->
    @if (Model.IsEditing)
    {
        <div class="mt-10 bg-white rounded-3xl shadow-md border border-gray-200 p-8">

            <h2 class="text-2xl font-bold mb-8">
                Editar Estudiante
            </h2>

            @using (Html.BeginForm("Students", "Administrator", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(m => m.IsEditing)

                <div class="grid md:grid-cols-2 gap-5">

                    <div>
                        @Html.LabelFor(m => m.Id)

                        @Html.TextBoxFor(m => m.Id,
                            new
                            {
                                @class = "border rounded-xl p-3 w-full bg-gray-100",
                                @readonly = "readonly"
                            })
                    </div>

                    <div>
                        @Html.LabelFor(m => m.Usuario)

                        @Html.TextBoxFor(m => m.Usuario,
                            new
                            {
                                @class = "border rounded-xl p-3 w-full bg-gray-100",
                                @readonly = "readonly"
                            })
                    </div>

                    <div>
                        @Html.LabelFor(m => m.Nombre)

                        @Html.TextBoxFor(m => m.Nombre,
                            new
                            {
                                @class = "border rounded-xl p-3 w-full"
                            })

                        @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "text-red-500 text-sm" })
                    </div>

                    <div>
                        @Html.LabelFor(m => m.Apellido)

                        @Html.TextBoxFor(m => m.Apellido,
                            new
                            {
                                @class = "border rounded-xl p-3 w-full"
                            })

                        @Html.ValidationMessageFor(m => m.Apellido, "", new { @class = "text-red-500 text-sm" })
                    </div>

                </div>

                <div class="text-end mt-8">

                    <button type="submit"
                            class="bg-blue-500 hover:bg-blue-600 text-white px-8 py-3 rounded-xl font-semibold">

                        <i class="bi bi-save"></i>
                        Guardar Cambios

                    </button>

                    <a href="@Url.Action("Students","Administrator")"
                       class="ml-3 bg-gray-500 hover:bg-gray-600 text-white px-8 py-3 rounded-xl">

                        Cancelar

                    </a>

                </div>
            }

        </div>
    }

    <!-- Tabla -->
    <div class="mt-10 bg-white rounded-3xl shadow-md border border-gray-200 p-8">

        <div class="flex justify-between items-center mb-6">

            <h2 class="text-2xl font-bold">
                Estudiantes registrados
            </h2>

            @using (Html.BeginForm("Students", "Administrator", FormMethod.Get))
            {
                <div class="flex gap-2">

                    <input type="text"
                           name="search"
                           value="@Request["search"]"
                           placeholder="Buscar estudiante..."
                           class="border rounded-xl p-3 w-72" />

                    <button type="submit"
                            class="bg-cyan-500 hover:bg-cyan-600 text-white px-4 rounded-xl">

                        <i class="bi bi-search"></i>

                    </button>

                </div>
            }

        </div>

        <table class="w-full">

            <thead class="border-b">

                <tr class="text-left">

                    <th class="py-3">Identificación</th>
                    <th>Usuario</th>
                    <th>Nombre</th>
                    <th>Apellido</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>

                </tr>

            </thead>

            <tbody>

                @if (Model.Students != null && Model.Students.Count > 0)
                {
                    foreach (var estudiante in Model.Students)
                    {
                        <tr class="border-b hover:bg-gray-50">

                            <td class="py-4">
                                @estudiante.Id
                            </td>

                            <td>
                                @estudiante.Usuario
                            </td>

                            <td>
                                @estudiante.Nombre
                            </td>

                            <td>
                                @estudiante.Apellido
                            </td>

                            <td>

                                @if (estudiante.Estado == "ACTIVO")
                                {
                                    <span class="px-3 py-1 rounded-full bg-green-100 text-green-700 text-sm font-medium">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="px-3 py-1 rounded-full bg-red-100 text-red-700 text-sm font-medium">
                                        Inactivo
                                    </span>
                                }

                            </td>

                            <td class="text-center">

                                <div class="flex justify-center gap-3">

                                    <a href="@Url.Action("EditStudent","Administrator",
                                        new { id = estudiante.Id })"
                                       class="text-blue-600 hover:text-blue-800 text-lg"
                                       title="Editar">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>

                                    @if (estudiante.Estado == "ACTIVO")
                                    {
                                        <a href="@Url.Action("ChangeStudentStatus","Administrator",
                                            new
                                            {
                                                id = estudiante.Id,
                                                estado = "INACTIVO"
                                            })"
                                           class="text-red-600 hover:text-red-800 text-lg"
                                           title="Desactivar">

                                            <i class="bi bi-person-x-fill"></i>

                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("ChangeStudentStatus","Administrator",
                                            new
                                            {
                                                id = estudiante.Id,
                                                estado = "ACTIVO"
                                            })"
                                           class="text-green-600 hover:text-green-800 text-lg"
                                           title="Activar">

                                            <i class="bi bi-person-check-fill"></i>

                                        </a>
                                    }

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="6"
                            class="text-center py-8 text-gray-500">

                            No hay estudiantes registrados.

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</section>
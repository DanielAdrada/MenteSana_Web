@model Presentation.Models.PsychologistViewModel
@{
    ViewBag.Title = "Gestión de Psicólogos";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="max-w-7xl mx-auto px-5 mt-6 mb-8">
    @if (TempData["Success"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-green-100 border border-green-300 text-green-800">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="mb-6 p-4 rounded-xl bg-red-100 border border-red-300 text-red-800">
            @TempData["Error"]
        </div>
    }

    <div class="relative overflow-hidden rounded-3xl shadow-2xl border border-white/20
                bg-gradient-to-r from-emerald-400 via-cyan-500 to-blue-600">

        <div class="absolute top-0 left-0 w-40 h-40 bg-white/10 rounded-full -translate-x-16 -translate-y-16"></div>
        <div class="absolute bottom-0 right-1/3 w-60 h-60 bg-white/5 rounded-full translate-y-24"></div>

        <div class="grid md:grid-cols-2 items-center min-h-[260px]">
            <div class="px-8 md:px-12 py-10 z-10">

                <span class="inline-flex items-center gap-2 bg-white/35 backdrop-blur-sm
                             text-green-700 border border-green-200 px-4 py-1.5 rounded-full
                             text-sm font-medium">
                    <i class="bi bi-shield-check"></i>
                    Panel Administrativo
                </span>

                <h1 class="mt-4 text-3xl md:text-5xl font-extrabold text-white">
                    Gestión de Psicólogos 👨‍⚕️
                </h1>

                <p class="mt-3 text-lg text-white/95">
                    Registra y administra los profesionales que brindarán acompañamiento
                    emocional a los estudiantes.
                </p>

                <p class="mt-2 text-white/90">
                    Mantén actualizado el equipo de orientación de la institución.
                </p>

            </div>
        </div>
    </div>

    <div class="mt-10 grid grid-cols-1 lg:grid-cols-4 gap-6">

        <div class="lg:col-span-3">

            <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-3xl shadow-md p-8">

                <h2 class="text-2xl font-bold text-gray-800 dark:text-white mb-8">
                    @(Model.IsEditing
      ? "Editar Psicólogo"
      : "Registrar Psicólogo")
                </h2>

                @if (ViewBag.Success != null)
                {
                    <div class="mb-6 p-4 rounded-xl bg-green-100 border border-green-300 text-green-800">
                        @ViewBag.Success
                    </div>
                }

                @if (ViewBag.Error != null)
                {
                    <div class="mb-6 p-4 rounded-xl bg-red-100 border border-red-300 text-red-800">
                        @ViewBag.Error
                    </div>
                }

                @using (Html.BeginForm("Psychologists", "Administrator", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.IsEditing)

                    <h3 class="font-semibold text-lg text-cyan-700 mb-4">
                        🔐 Datos de acceso
                    </h3>

                    <div class="grid md:grid-cols-3 gap-5">

                        <div>
                            @if (Model.IsEditing)
                            {
                                @Html.TextBoxFor(m => m.Id, new
                                {
                                    @class = "border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-white rounded-xl p-3 w-full",
                                    placeholder = "Identificación",
                                    @readonly = "readonly"
                                })
                            }
                            else
                            {
                                @Html.TextBoxFor(m => m.Id, new
                                {
                                    @class = "border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-white rounded-xl p-3 w-full",
                                    placeholder = "Identificación"
                                })
                            }

                            @Html.ValidationMessageFor(m => m.Id, "", new
                            {
                                @class = "text-red-500 text-sm"
                            })
                        </div>

                        <div>
                            @Html.TextBoxFor(m => m.Usuario, new
                            {
                                @class = "border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-white rounded-xl p-3 w-full",
                                placeholder = "Usuario"
                            })
                            @Html.ValidationMessageFor(m => m.Usuario, "", new
                            {
                                @class = "text-red-500 text-sm"
                            })
                        </div>

                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1"></label>

                            <div class="relative">

                                @Html.PasswordFor(m => m.Password, new
                                {
                                    @class = "border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-white rounded-xl p-3 w-full",
                                    placeholder = "Contraseña",
                                    id = "Password"
                                })

                                <button type="button"
                                        id="togglePassword"
                                        class="absolute inset-y-0 right-0 flex items-center px-4
                                          text-gray-500 hover:text-cyan-600 transition"
                                        aria-label="Mostrar contraseña"
                                        title="Mostrar contraseña">

                                    <i id="passwordIcon" class="bi bi-eye text-lg"></i>

                                </button>

                            </div>

                            @Html.ValidationMessageFor(m => m.Password, "", new
                            {
                                @class = "text-red-500 text-sm"
                            })

                        </div>

                    </div>

                    <h3 class="font-semibold text-lg text-cyan-700 mt-8 mb-4">
                        👤 Información personal
                    </h3>

                    <div class="grid md:grid-cols-2 gap-5">

                        <div>
                            @Html.TextBoxFor(m => m.Nombre, new
                            {
                                @class = "border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-white rounded-xl p-3 w-full",
                                placeholder = "Nombre"
                            })
                            @Html.ValidationMessageFor(m => m.Nombre, "", new
                            {
                                @class = "text-red-500 text-sm"
                            })
                        </div>

                        <div>
                            @Html.TextBoxFor(m => m.Apellido, new
                            {
                                @class = "border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-white rounded-xl p-3 w-full",
                                placeholder = "Apellido"
                            })
                            @Html.ValidationMessageFor(m => m.Apellido, "", new
                            {
                                @class = "text-red-500 text-sm"
                            })
                        </div>

                        <div>
                            @Html.TextBoxFor(m => m.Correo, new
                            {
                                @class = "border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-white rounded-xl p-3 w-full",
                                placeholder = "Correo institucional",
                                type = "email"
                            })
                            @Html.ValidationMessageFor(m => m.Correo, "", new
                            {
                                @class = "text-red-500 text-sm"
                            })
                        </div>

                        <div>
                            @Html.TextBoxFor(m => m.Telefono, new
                            {
                                @class = "border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-white rounded-xl p-3 w-full",
                                placeholder = "Teléfono"
                            })
                            @Html.ValidationMessageFor(m => m.Telefono, "", new
                            {
                                @class = "text-red-500 text-sm"
                            })
                        </div>

                    </div>

                    <h3 class="font-semibold text-lg text-cyan-700 mt-8 mb-4">
                        🎓 Información profesional
                    </h3>

                    <div>
                        @Html.TextBoxFor(m => m.Formacion, new
                        {
                            @class = "border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-white rounded-xl p-3 w-full",
                            placeholder = "Formación académica"
                        })
                        @Html.ValidationMessageFor(m => m.Formacion, "", new
                        {
                            @class = "text-red-500 text-sm"
                        })
                    </div>

                    <div class="mt-5">
                        @Html.TextAreaFor(m => m.Horario, new
                        {
                            @class = "border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-gray-800 dark:text-white rounded-xl p-3 w-full",
                            rows = 4,
                            placeholder = "Horario de atención"
                        })
                        @Html.ValidationMessageFor(m => m.Horario, "", new
                        {
                            @class = "text-red-500 text-sm"
                        })
                    </div>

                    <div class="mt-8 text-end">

                        @if (Model.IsEditing)
                        {
                            <button type="submit"
                                    class="bg-blue-500 hover:bg-blue-600 text-white px-8 py-3 rounded-xl font-semibold">
                                <i class="bi bi-save"></i>
                                Guardar Cambios
                            </button>

                            <a href="@Url.Action("Psychologists", "Administrator")"
                               class="bg-gray-500 hover:bg-gray-600 text-white px-8 py-3 rounded-xl font-semibold mr-2">
                                
                                Cancelar
                            </a>
                        }
                        else
                        {
                            <button type="submit"
                                    class="bg-green-500 hover:bg-green-600 text-white px-8 py-3 rounded-xl font-semibold">
                                <i class="bi bi-plus-circle"></i>
                                Registrar Psicólogo
                            </button>
                        }

                    </div>

                }

            </div>

        </div>

        <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-3xl shadow-md p-6 h-fit">

            <h3 class="font-bold text-xl mb-6">
                📋 Buenas prácticas
            </h3>

            <div class="space-y-6">

                <div>
                    <p class="font-semibold">👤 Información completa</p>
                    <p class="text-sm text-gray-500 dark:text-gray-300">
                        Verifica los datos antes de registrar al profesional.
                    </p>
                </div>

                <div>
                    <p class="font-semibold">🔐 Credenciales seguras</p>
                    <p class="text-sm text-gray-500 dark:text-gray-300">
                        Entrega el usuario y contraseña únicamente al psicólogo.
                    </p>
                </div>

                <div>
                    <p class="font-semibold">📞 Contacto actualizado</p>
                    <p class="text-sm text-gray-500 dark:text-gray-300">
                        Mantén el correo, teléfono y horario siempre actualizados.
                    </p>
                </div>

                <div>
                    <p class="font-semibold">🏫 Personal autorizado</p>
                    <p class="text-sm text-gray-500 dark:text-gray-300">
                        Solo registra profesionales aprobados por la institución.
                    </p>
                </div>

            </div>

        </div>

    </div>

    <div id="psychologists"
         class="mt-10 bg-white dark:bg-gray-800 rounded-3xl shadow-md border border-gray-200 dark:border-gray-700 p-8">

        <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-bold">
                Psicólogos registrados
            </h2>

            <form method="get"
                  action="@Url.Action("Psychologists", "Administrator")#psychologists">

                <div class="flex gap-2">

                    <input type="text"
                           name="search"
                           value="@Request["search"]"
                           placeholder="Buscar psicólogo..."
                           class="border border-gray-300 dark:border-gray-600
                   bg-white dark:bg-gray-700
                   text-gray-800 dark:text-white
                   rounded-xl p-3 w-72" />

                    <button type="submit"
                            class="bg-cyan-500 hover:bg-cyan-600 text-white px-4 rounded-xl">

                        <i class="bi bi-search"></i>

                    </button>

                </div>

            </form>
        </div>

        <table class="w-full">

            <thead class="border-b">
                <tr class="text-left">
                    <th class="py-3">Nombre</th>
                    <th>Correo</th>
                    <th>Teléfono</th>
                    <th>Estado</th>
                    <th class="text-center">Acciones</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Psychologists != null && Model.Psychologists.Count > 0)
                {
                    foreach (var psicologo in Model.Psychologists)
                    {
                        <tr class="border-b border-gray-200 dark:border-gray-700 hover:bg-gray-50 dark:hover:bg-gray-700">

                            <td class="py-4 font-medium">
                                @psicologo.Nombre @psicologo.Apellido
                            </td>

                            <td>
                                @psicologo.Correo
                            </td>

                            <td>
                                @(string.IsNullOrEmpty(psicologo.Telefono)
                                ? "--"
                                : psicologo.Telefono)
                            </td>

                            <td>
                                @if (psicologo.Estado == "ACTIVO")
                                {
                                    <span class="px-3 py-1 rounded-full bg-green-100 text-green-700 text-sm font-medium">
                                        Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="px-3 py-1 rounded-full bg-red-100 text-red-700 text-sm font-medium">
                                        Inactivo
                                    </span>
                                }
                            </td>

                            <td class="text-center">

                                <div class="flex justify-center items-center gap-3">

                                    <a href="@Url.Action("EditPsychologist", "Administrator",
                                        new { id = psicologo.Id })"
                                       class="text-blue-600 hover:text-blue-800 text-lg"
                                       title="Editar">

                                        <i class="bi bi-pencil-square"></i>

                                    </a>

                                    @if (psicologo.Estado == "ACTIVO")
                                    {
                                        <a href="@Url.Action("ChangePsychologistStatus",
                                 "Administrator",
                                 new
                                 {
                                     id = psicologo.Id,
                                     estado = "INACTIVO"
                                 })"
                                           class="text-red-600 hover:text-red-800 text-lg"
                                           title="Desactivar">

                                            <i class="bi bi-person-x-fill"></i>

                                        </a>
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("ChangePsychologistStatus",
                                 "Administrator",
                                 new
                                 {
                                     id = psicologo.Id,
                                     estado = "ACTIVO"
                                 })"
                                           class="text-green-600 hover:text-green-800 text-lg"
                                           title="Activar">

                                            <i class="bi bi-person-check-fill"></i>

                                        </a>
                                    }

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5"
                            class="text-center py-8 text-gray-500">
                            No hay psicólogos registrados.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</section>

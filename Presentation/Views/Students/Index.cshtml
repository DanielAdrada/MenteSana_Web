@model Presentation.Models.StudentHomeViewModel
@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewBag.Title = "Panel del Estudiante";
}

<!-- HERO --> 
<<section class="max-w-7xl mx-auto px-5 mt-6 mb-8">

    <div class="relative overflow-hidden rounded-3xl shadow-2xl border border-white/20
                bg-gradient-to-r from-emerald-400 via-cyan-500 to-blue-600">

        <!-- Decoraciones -->
        <div class="absolute top-0 left-0 w-40 h-40 bg-white/10 rounded-full -translate-x-16 -translate-y-16"></div>
        <div class="absolute bottom-0 right-1/3 w-60 h-60 bg-white/5 rounded-full translate-y-24"></div>

        <!-- Estrellitas -->
        <div class="absolute inset-0 pointer-events-none">
            <div class="absolute top-10 right-[48%] text-white/40 text-xl">✦</div>
            <div class="absolute top-20 right-[35%] text-white/50 text-2xl">✦</div>
            <div class="absolute top-32 right-[28%] text-white/40 text-sm">✦</div>
            <div class="absolute top-44 right-[18%] text-white/60 text-3xl">✦</div>
            <div class="absolute bottom-24 right-[30%] text-white/40 text-xl">✦</div>
            <div class="absolute bottom-16 right-20 text-white/50 text-2xl">✦</div>
            <div class="absolute top-56 right-[40%] text-white/30 text-lg">✦</div>
            <div class="absolute top-16 right-60 text-white/60 text-sm">✦</div>
        </div>

        <div class="grid md:grid-cols-2 items-center min-h-[270px]">

            <!-- TEXTO -->
            <div class="px-8 md:px-12 py-10 z-10">

                <span class="inline-flex items-center gap-2 bg-white/35 backdrop-blur-sm text-green-700 border border-green-200 px-4 py-1.5 rounded-full text-xs md:text-sm  font-medium">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         class="w-5 h-5"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M12 3l7 4v5c0 5-3.5 8-7 9-3.5-1-7-4-7-9V7l7-4z" />
                    </svg>
                    Espacio seguro
                </span>

                <h1 class="mt-4 text-3xl md:text-5xl font-extrabold text-white drop-shadow-lg whitespace-nowrap">
                    ¡Hola, @Session["Usuario"] 👋!

                </h1>

                <p class="mt-3 text-lg md:text-1xl text-white/95 max-w-xl leading-relaxed">
                    Bienvenido a <strong>MenteSana</strong>.
                    Aquí puedes explorar tus emociones, aprender a cuidarte y compartir sin juicios.
                </p>

                <div class="flex flex-wrap gap-3 mt-6">
                    <button onclick="location.href='@Url.Action("Survey","TestEmotional")'"
                            class="bg-white dark:bg-gray-700 text-deep dark:text-white px-5 py-3 rounded-xl font-semibold shadow hover:-translate-y-[2px] transition">
                        🧭 Test de emociones
                    </button>
                </div>


            </div>

        </div>

    </div>

    <!-- PSICOLOGOS DISPONIBLES -->
    <section class="max-w-7xl mx-auto px-5 mt-8 mb-8">

        <div class="bg-card dark:bg-slate-800
                    rounded-xl2
                    shadow-soft
                    overflow-hidden">

            <!-- ENCABEZADO -->
            <div class="relative overflow-hidden
                    bg-gradient-to-r
                    from-emerald-50
                    via-cyan-50
                    to-blue-50
                    dark:from-slate-800
                    dark:via-slate-800
                    dark:to-slate-700
                    px-6 md:px-8 py-7">

                <!-- Decoración -->
                <div class="absolute -right-10 -top-16
                        w-40 h-40
                        rounded-full
                        bg-emerald-200/30
                        dark:bg-emerald-500/10">
                </div>

                <div class="relative flex flex-col md:flex-row
                        md:items-center
                        md:justify-between
                        gap-5">

                    <div class="flex items-start gap-4">

                        <div class="w-12 h-12
                                flex-shrink-0
                                rounded-2xl
                                bg-gradient-to-br
                                from-emerald-400
                                to-cyan-500
                                flex items-center justify-center
                                text-2xl
                                shadow-md">
                            🧠
                        </div>

                        <div>

                            <h2 class="text-xl md:text-2xl
                                   font-extrabold
                                   text-deep
                                   dark:text-white">

                                ¿Necesitas hablar con un profesional?

                            </h2>

                            <p class="mt-1
                                  text-sm md:text-base
                                  text-muted
                                  dark:text-gray-300
                                  max-w-2xl">

                                Si necesitas orientación o apoyo,
                                puedes comunicarte con uno de nuestros
                                psicólogos.

                            </p>

                        </div>

                    </div>


                    <div class="hidden md:flex
                            items-center gap-2
                            px-4 py-2
                            rounded-xl
                            bg-white/70
                            dark:bg-slate-700/70
                            text-sm font-semibold
                            text-emerald-700
                            dark:text-emerald-300">

                        <span>💙</span>

                        <span>
                            Estamos para acompañarte
                        </span>

                    </div>

                </div>

            </div>

            <!-- LISTADO DE PSICÓLOGOS -->
            <div class="p-6 md:p-8">

                @if (Model.Psicologos != null && Model.Psicologos.Any())
                {
                    <!-- CONTENEDOR DEL CARRUSEL -->
                    <div class="relative">

                        <!-- FLECHA IZQUIERDA -->
                        <button type="button"
                                onclick="moverPsicologos(-1)"
                                class="absolute left-0 top-1/2 -translate-y-1/2 z-20
                           w-11 h-11
                           rounded-full
                           bg-white
                           dark:bg-slate-700
                           border border-gray-200
                           dark:border-slate-600
                           shadow-lg
                           flex items-center justify-center
                           text-xl
                           text-gray-700
                           dark:text-white
                           hover:scale-110
                           hover:shadow-xl
                           transition-all">

                            ‹

                        </button>


                        <!-- ÁREA DESLIZABLE -->
                        <div id="carruselPsicologos"
                             class="flex gap-5
                        overflow-x-auto
                        scroll-smooth
                        snap-x snap-mandatory
                        px-8
                        pb-3
                        scrollbar-hide">

                            @foreach (var psicologo in Model.Psicologos)
                            {
                                <article class="group
                                    relative
                                    flex-shrink-0
                                    w-[85%]
                                    sm:w-[48%]
                                    lg:w-[31.5%]
                                    snap-start
                                    rounded-2xl
                                    border
                                    border-gray-100
                                    dark:border-slate-600
                                    bg-white
                                    dark:bg-slate-700/50
                                    p-5
                                    shadow-sm
                                    hover:shadow-xl
                                    hover:-translate-y-1
                                    transition-all
                                    duration-300">


                                    <!-- FOTO / INICIALES -->
                                    <!-- FOTO / INICIALES -->
                                    <div class="flex justify-center pt-3">

                                        <div class="w-24 h-24 rounded-full
                                                     p-1
                                                     bg-blue-200
                                                     shadow-md">

                                             <div class="w-full h-full
                                                          rounded-full
                                                          bg-gradient-to-br
                                                         from-blue-50
                                                          to-emerald-50
                                                         flex items-center
                                                         justify-center">

                                                <span class="text-2xl
                                                            font-bold
                                                           text-blue-500">

                                                    @(string.IsNullOrEmpty(psicologo.Nombre)
                                                          ? ""
                                                          : psicologo.Nombre.Substring(0, 1).ToUpper())
                                                    @(string.IsNullOrEmpty(psicologo.Apellido)
                                                          ? ""
                                                          : psicologo.Apellido.Substring(0, 1).ToUpper())

                                                </span>

                                            </div>

                                        </div>

                                    </div>


                                    <!-- NOMBRE -->
                                    <div class="text-center mt-4">

                                        <h3 class="font-bold
                                       text-lg
                                       text-deep
                                       dark:text-white">

                                            @psicologo.Nombre
                                            @psicologo.Apellido

                                        </h3>

                                        <p class="text-sm
                                      text-muted
                                      dark:text-gray-300
                                      mt-1">

                                            Psicólogo profesional

                                        </p>

                                    </div>


                                    <!-- DATOS -->
                                    <div class="mt-5 space-y-2.5">

                                        <!-- CORREO -->
                                        <div class="flex items-center gap-3
                                        text-sm
                                        text-gray-600
                                        dark:text-gray-300">

                                            <span class="w-8 h-8
                                                            rounded-lg
                                                            bg-blue-100
                                                            dark:bg-blue-900/30
                                                            flex items-center
                                                            justify-center">
                                                ✉️
                                            </span>

                                            <span class="truncate">

                                                @psicologo.Correo

                                            </span>

                                        </div>


                                        <!-- TELÉFONO -->
                                        <div class="flex items-center gap-3
                                        text-sm
                                        text-gray-600
                                        dark:text-gray-300">

                                            <span class="w-8 h-8
                                             rounded-lg
                                             bg-emerald-50
                                             dark:bg-emerald-900/30
                                             flex items-center
                                             justify-center">

                                                📱
                                            </span>

                                            <span>

                                                @(string.IsNullOrEmpty(psicologo.Telefono)
                                        ? "Teléfono no registrado"
                                        : psicologo.Telefono)

                                            </span>

                                        </div>


                                        <!-- FORMACIÓN -->
                                        <div class="flex items-center gap-3
                                        text-sm
                                        text-gray-600
                                        dark:text-gray-300">

                                            <span class="w-8 h-8
                                             rounded-lg
                                             bg-purple-50
                                             dark:bg-purple-900/30
                                             flex items-center
                                             justify-center">

                                                🎓

                                            </span>

                                            <span class="truncate">

                                                @(string.IsNullOrEmpty(psicologo.Formacion)
                                        ? "Formación no registrada"
                                        : psicologo.Formacion)

                                            </span>

                                        </div>

                                    </div>


                                    <!-- BOTONES -->
                                    <div class="mt-5 grid grid-cols-2 gap-3">

                                        <!-- CORREO -->
                                        @if (!string.IsNullOrWhiteSpace(psicologo.Correo))
                                        {
                                            <a href="https://mail.google.com/mail/?view=cm&fs=1&to=@psicologo.Correo"
                                               target="_blank"
                                               class="flex items-center justify-center gap-2
                                                    bg-emerald-100
                                                    hover:bg-emerald-200
                                                   text-emerald-700
                                                  font-semibold
                                                   py-2.5
                                                   px-3
                                                   rounded-xl
                                                  shadow-md
                                                  hover:shadow-lg
                                                  hover:-translate-y-0.5
                                                   transition-all
                                                   text-sm">

                                                ✉️ Correo

                                            </a>
                                        }
                                        else
                                        {
                                            <span class="flex items-center justify-center gap-2
                                             bg-gray-200
                                             dark:bg-slate-600
                                             text-gray-500
                                             dark:text-gray-300
                                             font-semibold
                                             py-2.5
                                             px-3
                                             rounded-xl
                                             text-sm">

                                                ✉️ Sin correo

                                            </span>
                                        }


                                        <!-- LLAMAR -->
                                        @if (!string.IsNullOrWhiteSpace(psicologo.Telefono))
                                        {
                                            <a href="tel:@psicologo.Telefono"
                                               class="flex items-center justify-center gap-2
                                                      bg-blue-100
                                                      hover:bg-blue-200
                                                      text-blue-700
                                                  font-semibold
                                                   py-2.5
                                                   px-3
                                                   rounded-xl
                                                  shadow-md
                                                  hover:shadow-lg
                                                  hover:-translate-y-0.5
                                                  transition-all
                                                  text-sm">
                                                📞 Llamar
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="flex items-center justify-center gap-2
                                             bg-gray-200
                                             dark:bg-slate-600
                                             text-gray-500
                                             dark:text-gray-300
                                             font-semibold
                                             py-2.5
                                             px-3
                                             rounded-xl
                                             text-sm">
                                                📞 Sin teléfono
                                            </span>
                                        }

                                    </div>

                                </article>
                            }

                        </div>

                        <!-- FLECHA DERECHA -->
                        <button type="button"
                                onclick="moverPsicologos(1)"
                                class="absolute right-0 top-1/2 -translate-y-1/2 z-20
                           w-11 h-11
                           rounded-full
                           bg-white
                           dark:bg-slate-700
                           border border-gray-200
                           dark:border-slate-600
                           shadow-lg
                           flex items-center justify-center
                           text-xl
                           text-gray-700
                           dark:text-white
                           hover:scale-110
                           hover:shadow-xl
                           transition-all">

                            ›

                        </button>

                    </div>
                }
                else
                {
                    <!-- SIN PSICÓLOGOS -->
                    <div class="flex flex-col
                    items-center
                    justify-center
                    py-10
                    px-6
                    rounded-2xl
                    bg-gradient-to-br
                    from-emerald-50
                    via-white
                    to-cyan-50
                    dark:from-slate-700
                    dark:via-slate-800
                    dark:to-slate-700
                    border
                    border-emerald-100
                    dark:border-slate-600">

                        <div class="w-16 h-16
                        rounded-full
                        bg-emerald-100
                        dark:bg-emerald-900/40
                        flex items-center justify-center
                        text-3xl
                        mb-4">

                            🧠

                        </div>

                        <h3 class="text-lg
                       font-bold
                       text-deep
                       dark:text-white">

                            Psicólogos no disponibles

                        </h3>

                        <p class="text-sm
                      text-muted
                      dark:text-gray-300
                      text-center
                      max-w-md
                      mt-2">

                            Actualmente no hay profesionales
                            disponibles para mostrar.

                        </p>

                    </div>
                }

            </div>

       </div>
 
    </section>

    <script>
        function moverPsicologos(direccion) {

            const carrusel = document.getElementById("carruselPsicologos");

            if (!carrusel) return;

            const tarjeta = carrusel.querySelector("article");

            if (!tarjeta) return;

            const anchoTarjeta = tarjeta.offsetWidth;
            const espacio = 20;

            carrusel.scrollBy({
                left: direccion * (anchoTarjeta + espacio),
                behavior: "smooth"
            });
        }
    </script>

    <!-- MAIN -->
    <main class="max-w-7xl mx-auto px-5 my-6 grid md:grid-cols-[2fr_1fr] gap-5">
        <!-- RECURSOS -->
        <section class="bg-card dark:bg-slate-800 rounded-xl2 shadow-soft p-[18px]">

            <div class="flex items-center justify-between mb-5">

                <div class="flex items-center gap-3">

                    <div class="w-11 h-11 rounded-2xl bg-blue-100 dark:bg-blue-900/40
                    flex items-center justify-center text-xl shadow-sm">
                        🎯
                    </div>

                    <div>
                        <h3 class="text-lg font-bold text-deep dark:text-white">
                            Recursos para ti hoy
                        </h3>

                        <p class="text-sm text-muted dark:text-gray-300 mt-0.5">
                            Contenido para acompañarte en tu bienestar emocional.
                        </p>
                    </div>

                </div>

            </div>

            <div class="grid md:grid-cols-3 sm:grid-cols-2 gap-4">

                @if (Model.Recursos != null && Model.Recursos.Any())
                {
                    foreach (var recurso in Model.Recursos)
                    {
                        <article class="group relative overflow-hidden rounded-2xl p-5
                    bg-gradient-to-br from-blue-100 via-white to-blue-50
                    dark:from-slate-700 dark:via-slate-800 dark:to-slate-700
                    border border-blue-200/60 dark:border-slate-600
                    shadow-sm hover:shadow-xl
                    transition-all duration-500
                    hover:-translate-y-2 hover:scale-[1.02]">

                            <!-- Efecto al pasar el mouse -->
                            <div class="absolute inset-0 bg-blue-200/30 opacity-0
                        group-hover:opacity-100 blur-2xl transition">
                            </div>

                            <!-- ICONO Y TÍTULO CENTRADOS -->
                            <div class="relative text-center">

                                @if (recurso.Tipo != null &&
                                     recurso.Tipo.ToLower() == "video")
                                {
                                    <div class="w-14 h-14 mx-auto rounded-2xl bg-red-100 dark:bg-red-900/30
                                               flex items-center justify-center text-3xl shadow-sm">
                                        🎥
                                    </div>
                                }
                                else if (recurso.Tipo != null &&
                                         recurso.Tipo.ToLower() == "documento")
                                {
                                    <div class="w-14 h-14 mx-auto rounded-2xl bg-blue-100 dark:bg-blue-900/30
                                                flex items-center justify-center text-3xl shadow-sm">
                                        📄
                                    </div>
                                }
                                else if (recurso.Tipo != null &&
                                         recurso.Tipo.ToLower() == "imagen")
                                {
                                    <div class="w-14 h-14 mx-auto rounded-2xl bg-purple-100 dark:bg-purple-900/30
                                                flex items-center justify-center text-3xl shadow-sm">
                                        🖼️
                                    </div>
                                }
                                else
                                {
                                    <div class="w-14 h-14 mx-auto rounded-2xl bg-emerald-100 dark:bg-emerald-900/30
                                                flex items-center justify-center text-3xl shadow-sm">
                                        🔗
                                    </div>
                                }

                                <strong class="block text-deep dark:text-white text-lg mt-2">
                                    @recurso.Titulo
                                </strong>

                            </div>

                            <!-- DESCRIPCIÓN -->
                            <p class="relative text-sm text-muted dark:text-gray-300 mt-4">
                                @recurso.Descripcion
                            </p>

                            <!-- FECHA -->
                            <p class="relative text-xs text-gray-400 dark:text-gray-400 mt-3">
                                Publicado: @recurso.Fecha.ToString("dd/MM/yyyy")
                            </p>

                            <!-- BOTÓN -->
                            @if (!string.IsNullOrWhiteSpace(recurso.Url))
                            {
                                <a href="@recurso.Url"
                                   target="_blank"
                                   class="relative inline-block mt-4 bg-blue-500 text-white px-4 py-2 rounded-xl
                                  hover:bg-blue-600 transition font-semibold">
                                    Abrir recurso
                                </a>
                            }
                            else if (!string.IsNullOrWhiteSpace(recurso.Archivo))
                            {
                                <a href="@Url.Content("~/Uploads/" + recurso.Archivo)"
                                   target="_blank"
                                   class="relative inline-block mt-4 bg-blue-500 text-white px-4 py-2 rounded-xl
                                  hover:bg-blue-600 transition font-semibold">
                                    Abrir recurso
                                </a>
                            }

                        </article>
                    }
                }
                else
                {
                    <div class="col-span-full flex flex-col items-center justify-center
                      py-10 px-6 rounded-2xl
                      bg-gradient-to-br from-blue-50 via-white to-emerald-50
                      dark:from-slate-700 dark:via-slate-800 dark:to-slate-700
                      border border-blue-100 dark:border-slate-600">

                        <div class="w-16 h-16 rounded-full bg-blue-100 dark:bg-blue-900/40
                         flex items-center justify-center text-3xl shadow-sm mb-4">
                            📚
                        </div>

                        <h4 class="text-lg font-bold text-deep dark:text-white">
                            Aún no hay recursos disponibles
                        </h4>

                        <p class="text-sm text-muted dark:text-gray-300 text-center
                         max-w-md mt-2">
                            Muy pronto podrás descubrir contenido para aprender sobre tus emociones y cuidar de tu bienestar.
                        </p>

                        <span class="mt-4 text-xs text-gray-400 dark:text-gray-400">
                            💙 Vuelve pronto
                        </span>

                    </div>
                }

            </div>

        </section>
        <!-- COMUNIDAD -->
        <aside class="bg-card dark:bg-slate-800 rounded-xl2 shadow-soft p-[18px]">
            <div class="flex items-center gap-3 mb-5">

                <div class="w-11 h-11 rounded-2xl bg-emerald-100 dark:bg-emerald-900/40
                flex items-center justify-center text-xl shadow-sm">
                    💬
                </div>

                <div>
                    <h3 class="text-lg font-bold text-deep dark:text-white">
                        Comunidad segura
                    </h3>

                    <p class="text-sm text-muted dark:text-gray-300 mt-0.5">
                        Un espacio para compartir y sentirse acompañado.
                    </p>
                </div>

            </div>

            <div class="space-y-3">

                @if (Model.Comentarios != null && Model.Comentarios.Any())
                {
                    foreach (var item in Model.Comentarios.Take(2))

                    {
                        <div class="bg-gradient-to-br from-gray-50 to-white
                                    dark:from-slate-700 dark:to-slate-800
                                    rounded-2xl p-4
                                    border border-gray-200 dark:border-slate-600
                                    hover:shadow-md hover:-translate-y-0.5
                                    transition-all duration-300">

                            <div class="flex items-start gap-3">

                                <div class="w-9 h-9 flex-shrink-0 rounded-full
                                            bg-blue-100 dark:bg-blue-900/40
                                            flex items-center justify-center
                                            text-sm font-bold text-blue-600 dark:text-blue-300">
                                    💙
                                </div>

                                <div class="min-w-0 flex-1">

                                    <strong class="block text-deep dark:text-white text-sm">
                                        @item.Usuario
                                    </strong>

                                    <p class="text-sm text-gray-700 dark:text-gray-200 mt-1 leading-relaxed">
                                        @item.Contenido
                                    </p>

                                    <span class="block text-xs text-gray-400 dark:text-gray-300 mt-2">
                                        📅 @item.Fecha.ToString("dd/MM/yyyy")
                                    </span>

                                </div>

                            </div>

                        </div>
                    }
                }

                else
                {
                    <div class="col-span-full flex flex-col items-center justify-center
                      py-10 px-6 rounded-2xl
                      bg-gradient-to-br from-blue-50 via-white to-emerald-50
                      dark:from-slate-700 dark:via-slate-800 dark:to-slate-700
                      border border-blue-100 dark:border-slate-600">

                        <div class="w-14 h-14 mx-auto rounded-full
                                    bg-emerald-100 dark:bg-emerald-900/40
                                    flex items-center justify-center
                                    text-2xl shadow-sm mb-3">
                            💙
                        </div>

                        <h4 class="text-base font-bold text-deep dark:text-white">
                            Comparte algo positivo
                        </h4>

                        <p class="text-sm text-muted dark:text-gray-300 text-center
                         max-w-md mt-2">
                            Este espacio está abierto para ti.
                            Puedes compartir algo que te haya ayudado o hecho sentir bien.
                        </p>

                    </div>
                }

            </div>

            <a href="@Url.Action("Index", "Community")"
               class="mt-5 block w-full bg-primary hover:bg-primary-600 text-black dark:text-white text-center font-semibold py-3 rounded-xl transition">
                ✨ Compartir algo positivo
            </a>
        </aside>

    </main>

</section>


@model List<Data.Models.CommentDTO>

@{
    Layout = "~/Views/Shared/_PsychologistLayout.cshtml";
    ViewBag.Title = "Gestion de Comentarios";
}

<section class="max-w-5xl mx-auto px-6 my-8">

    <div class="mb-8">
        <h2 class="text-3xl font-bold">Gestión de Comentarios</h2>
        <p class="text-gray-500">
            Visualiza los comentarios publicados por los estudiantes.
        </p>
    </div>

    @if (TempData["ErrorRespuesta"] != null)
    {
        <div class="bg-red-100
                border border-red-300
                text-red-700
                px-4 py-3
                rounded-lg
                mb-4">

            @TempData["ErrorRespuesta"]

        </div>
    }

    <div class="space-y-6">

        @foreach (var item in Model)
        {
            <article class="group bg-gradient-to-br from-white to-gray-50
                           border border-gray-200
                           rounded-2xl p-5
                           shadow-sm hover:shadow-xl
                           transition-all duration-500">

                <div class="flex items-center gap-4 mb-3">

                    <div class="w-11 h-11 rounded-full overflow-hidden shadow flex items-center justify-center
                                bg-gradient-to-br from-primary to-secondary text-white font-bold text-lg">

                        @if (!string.IsNullOrEmpty(item.FotoRuta))
                        {
                            <img src="@Url.Content(item.FotoRuta)"
                                 class="w-full h-full object-cover" />
                        }
                        else
                        {
                            @($"{item.Nombre[0]}{item.Apellido[0]}".ToUpper())
                        }
                    </div>

                    <div class="flex-1">
                        <p class="font-semibold">
                            @item.Nombre @item.Apellido
                        </p>

                        <p class="text-xs text-gray-500">
                            Usuario: @item.Usuario
                        </p>

                        <p class="text-xs text-gray-500">
                            @item.Fecha.ToString("dd/MM/yyyy HH:mm")
                        </p>
                    </div>

                </div>

                <p class="text-gray-700 leading-relaxed">
                    @item.Contenido
                </p>

                @if (string.IsNullOrEmpty(item.Respuesta))
                {
                    <form method="post"
                          action="@Url.Action("ResponderComentario","Community")">

                        <input type="hidden"
                               name="comentarioId"
                               value="@item.Id" />

                        <textarea name="respuesta"
                                  rows="3"
                                  required
                                  class="w-full border rounded-lg mt-3 p-2"
                                  placeholder="Escribir respuesta">
                        </textarea>

                        <button type="submit"
                                class="mt-2 px-4 py-2 bg-blue-600 text-white rounded">
                            Responder
                        </button>
                    </form>

                }
                else
                {
                    <div class="mt-4 p-3 bg-blue-50 rounded-lg">

                        <p class="font-semibold">
                            Respuesta del psicólogo
                        </p>

                        <p>
                            @item.Respuesta
                        </p>

                        <small>
                            @(item.FechaRespuesta != null
                                ? item.FechaRespuesta.Value.ToString("dd/MM/yyyy HH:mm")
                                : "")
                        </small>

                    </div>
                }

            </article>
        }

    </div>

</section>

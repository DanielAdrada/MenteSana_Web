@model IEnumerable<Presentation.Models.CommentViewModel>

@{
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
    ViewBag.Title = "Comunidad";
}

<!-- HERO -->
<section class="max-w-7xl mx-auto px-5 mt-6 mb-8">

    <div class="relative overflow-hidden rounded-3xl shadow-2xl border border-white/20
                bg-gradient-to-r from-emerald-400 via-cyan-500 to-blue-600">

        <!-- Decoraciones -->
        <div class="absolute top-0 left-0 w-40 h-40 bg-white/10 rounded-full -translate-x-16 -translate-y-16"></div>
        <div class="absolute bottom-0 right-1/3 w-60 h-60 bg-white/5 rounded-full translate-y-24"></div>

        <!-- Estrellitas -->
        <div class="absolute inset-0 pointer-events-none">
            <div class="absolute top-10 right-[48%] text-white/40 text-xl">✦</div>
            <div class="absolute top-20 right-[35%] text-white/50 text-2xl">✦</div>
            <div class="absolute top-32 right-[28%] text-white/40 text-sm">✦</div>
            <div class="absolute top-44 right-[18%] text-white/60 text-3xl">✦</div>
            <div class="absolute bottom-24 right-[30%] text-white/40 text-xl">✦</div>
            <div class="absolute bottom-16 right-20 text-white/50 text-2xl">✦</div>
            <div class="absolute top-56 right-[40%] text-white/30 text-lg">✦</div>
            <div class="absolute top-16 right-60 text-white/60 text-sm">✦</div>
        </div>

        <div class="grid md:grid-cols-2 items-center min-h-[270px]">

            <!-- TEXTO -->
            <div class="px-8 md:px-12 py-10 z-10">

                <span class="inline-flex items-center gap-2 bg-white/35 backdrop-blur-sm text-green-700 border border-green-200 px-4 py-1.5 rounded-full text-xs md:text-sm  font-medium">

                    <svg xmlns="http://www.w3.org/2000/svg"
                         class="w-5 h-5"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke="currentColor">
                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              stroke-width="2"
                              d="M12 3l7 4v5c0 5-3.5 8-7 9-3.5-1-7-4-7-9V7l7-4z" />
                    </svg>
                    Espacio seguro
                </span>

                <h1 class="mt-4 text-3xl md:text-5xl font-extrabold text-white drop-shadow-lg whitespace-nowrap">
                    Comunidad Mente Sana 💙
                </h1>

                <p class="mt-3 text-lg md:text-2xl text-white/95 max-w-xl leading-relaxed">
                    Comparte experiencias, pensamientos y apoyo con otros estudiantes.
                </p>

                <p class="mt-1 text-lg md:text-1xl text-white/95">
                    Aquí nadie juzga 💙
                </p>

            </div>

        </div>

    </div>

    
    <div class="mt-12">

        <!-- CONTENIDO -->
        <div class="grid grid-cols-1 lg:grid-cols-4 gap-6">

            <!-- FORMULARIO -->
            <div class="lg:col-span-3">

                <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm">

                    <!-- TODO TU FORMULARIO ACTUAL AQUÍ -->
                    <div class="flex items-start gap-4">

                        <div class="w-14 h-14 rounded-full bg-blue-100 flex items-center justify-center shrink-0">
                            <span class="text-2xl">💙</span>
                        </div>

                        <div class="flex-1">

                            <p class="text-gray-600 mb-5">
                                Tu mensaje puede ayudar a alguien más. Escribe con respeto y empatía.
                            </p>

                            <form method="post" action="@Url.Action("Create", "Community")">

                                <textarea name="contenido"
                                          rows="4"
                                          placeholder="¿Qué te gustaría compartir hoy?"
                                          class="w-full p-4 rounded-2xl resize-none border border-gray-200 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>

                                <div class="flex justify-end mt-4">

                                    <button type="submit"
                                            class="px-8 py-3 bg-green-500 text-white font-semibold rounded-xl hover:bg-green-600 transition">
                                        Publicar 💙
                                    </button>

                                </div>

                            </form>

                        </div>

                    </div>

                </div>

            </div>

            <!-- PANEL DERECHO -->
            <div class="bg-white border border-gray-200 rounded-2xl p-6 shadow-sm h-fit">

                <div class="space-y-6">
                    <h3 class="font-bold text-lg mb-6">
                        🛡️ Recuerda
                    </h3>

                    <div class="flex gap-3">
                        <div class="text-2xl">👥</div>
                        <div>
                            <p class="font-semibold">Sé respetuoso</p>
                            <p class="text-sm text-gray-500">
                                Cada experiencia es única.
                            </p>
                        </div>
                    </div>

                    <div class="flex gap-3">
                        <div class="text-2xl">🔒</div>
                        <div>
                            <p class="font-semibold">Comparte con confianza</p>
                            <p class="text-sm text-gray-500">
                                Tu privacidad es importante.
                            </p>
                        </div>
                    </div>

                    <div class="flex gap-3">
                        <div class="text-2xl">🤝</div>
                        <div>
                            <p class="font-semibold">Apoyémonos siempre</p>
                            <p class="text-sm text-gray-500">
                                La empatía nos une.
                            </p>
                        </div>
                    </div>

                </div>

            </div>

        </div>

        <!-- COMENTARIOS -->
        <div class="grid grid-cols-1 lg:grid-cols-1 gap-6 mt-8">

            <div class="lg:col-span-3 space-y-6">

                @foreach (var item in Model)
                {
                    <article class="bg-white border border-gray-200 rounded-3xl p-8 shadow-md">

                        <div class="flex items-center gap-4 mb-3">

                            <!-- Avatar -->
                            <div class="w-14 h-14 rounded-full overflow-hidden shadow flex items-center justify-center bg-gradient-to-br from-primary to-secondary text-white font-bold text-lg">

                                @if (!string.IsNullOrEmpty(item.FotoPerfil))
                                {
                                    <img src="@Url.Content(item.FotoPerfil)?v=@DateTime.Now.Ticks"
                                         alt="Foto perfil"
                                         class="w-full h-full object-cover" />
                                }
                                else
                                {
                                    @($"{item.Nombre[0]}{item.Apellido[0]}".ToUpper())
                                }
                            </div>

                            <div class="flex-1">
                                <p class="text-1xl font-semibold text-slate-800">
                                    @(string.IsNullOrEmpty(item.Nombre)
                                ? item.Usuario
                                : $"{item.Nombre} {item.Apellido}")
                                </p>

                                <p class="text-xs text-muted">
                                    @item.Fecha.ToString("dd MMM yyyy")
                                </p>
                            </div>

                        </div>

                        <p class="text-gray-700 leading-relaxed">
                            @item.Contenido
                        </p>

                        @if (!string.IsNullOrEmpty(item.Respuesta))
                        {
                            <div class="mt-4 p-4 bg-blue-50 dark:bg-slate-700 rounded-xl border-l-4 border-blue-500">

                                <p class="font-semibold text-blue-700 dark:text-blue-300">
                                    👨‍⚕️ Respuesta del psicólogo
                                </p>

                                <p class="mt-2 text-gray-700 dark:text-gray-200">
                                    @item.Respuesta
                                </p>

                                @if (item.FechaRespuesta != null)
                                {
                                    <small class="text-gray-500">
                                        Respondido el @(item.FechaRespuesta.Value.ToString("dd/MM/yyyy HH:mm"))
                                    </small>
                                }
                            </div>
                        }

                    </article>
                 }

            </div>

        </div>

    </div>

</section>
